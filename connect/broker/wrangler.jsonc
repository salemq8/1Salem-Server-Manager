// 1Salem Connect broker. Phase 1 runs locally only (`wrangler dev --local`); nothing here is
// deployed. Secrets never go in this file or in `vars`: locally they live in a git-ignored
// `.dev.vars` generated by scripts/new-dev-secrets.mjs, and in Cloudflare they would be set with
// `wrangler secret put`. A deployment also needs the outer rate limit described in README.md
// ("Requirements outside the broker"); it is deliberately not configured here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onesalem-connect-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",

  // No public workers.dev hostname or preview URL: Phase 1 must not be reachable from the
  // internet even if someone runs `wrangler deploy` by mistake.
  "workers_dev": false,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onesalem-connect",
      // Placeholder. A real id exists only after `wrangler d1 create`, which Phase 1 never runs.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Declares the secret names so local dev warns when they are missing. Values are never here.
  "secrets": {
    "required": ["TICKET_SIGNING_KEY", "INVITE_PEPPER"]
  },

  // Purges expired nonces, rate counters, enrollment blobs and old sessions (src/maintenance.ts).
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // The local dev server and its inspector listen on loopback only.
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "inspector_ip": "127.0.0.1",
    "local_protocol": "http"
  }
}
