// 1Salem Connect broker. The top-level environment stays local-only. env.production is a
// production-ready template, but nothing in this repository creates resources or deploys it.
// Secrets never go in this file or in vars: locally they live in a git-ignored .dev.vars, and a
// production operator sets them with Wrangler's interactive secret command.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onesalem-connect-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",

  // No public workers.dev hostname or preview URL: Phase 1 must not be reachable from the
  // internet even if someone runs `wrangler deploy` by mistake.
  "workers_dev": false,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onesalem-connect",
      // Placeholder. A real id exists only after `wrangler d1 create`, which Phase 1 never runs.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Declares the secret names so local dev warns when they are missing. Values are never here.
  "secrets": {
    "required": ["TICKET_SIGNING_KEY", "INVITE_PEPPER"]
  },

  // Purges expired nonces, rate counters, enrollment blobs and old sessions (src/maintenance.ts).
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // The local dev server and its inspector listen on loopback only.
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "inspector_ip": "127.0.0.1",
    "local_protocol": "http"
  },

  "env": {
    "production": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "connect.1salem.app/v1/*",
          "zone_name": "1salem.app"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "onesalem-connect-production",
          // Deployment step: replace this placeholder with the id printed by `wrangler d1 create`.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "secrets": {
        "required": ["TICKET_SIGNING_KEY", "INVITE_PEPPER"]
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "ratelimits": [
        {
          "name": "FLOOD",
          // Must remain unique within the Cloudflare account. See the deployment runbook.
          "namespace_id": "1001",
          "simple": {
            // Deliberately well above the exact per-identity D1 budgets; this catches floods only.
            "limit": 2000,
            "period": 60
          }
        }
      ],
      "vars": {
        "CONNECT_REQUIRE_FLOOD_LIMIT": "true"
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false,
          "persist": true
        }
      }
    }
  }
}
