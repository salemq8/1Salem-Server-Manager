// 1Salem Connect broker. The top-level environment stays local-only. env.production is the live
// deployment (`npx wrangler deploy --env production`, Worker onesalem-connect-broker-production),
// served at https://onesalem-connect-broker-production.onesalemconnect.workers.dev.
// Secrets never go in this file or in vars: locally they live in a git-ignored .dev.vars, and a
// production operator sets them with Wrangler's interactive secret command.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onesalem-connect-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",

  // No public workers.dev hostname or preview URL: the default environment must not be reachable from the
  // internet even if someone runs `wrangler deploy` by mistake.
  "workers_dev": false,
  "preview_urls": false,

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "onesalem-connect",
      // Placeholder for the local-only environment; production has its own database below.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // Declares the secret names so local dev warns when they are missing. Values are never here.
  "secrets": {
    "required": ["TICKET_SIGNING_KEY", "INVITE_PEPPER"]
  },

  // Purges expired nonces, rate counters, enrollment blobs and old sessions (src/maintenance.ts).
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // The local dev server and its inspector listen on loopback only.
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "inspector_ip": "127.0.0.1",
    "local_protocol": "http"
  },

  "env": {
    "production": {
      // Production is served on its workers.dev hostname: the API at /v1/* and the invite landing
      // page at /i (links are <origin>/i#<secret>). Preview URLs stay off. A custom domain is a
      // possible later migration (see the broker README); it is not configured.
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "onesalem-connect-production",
          // Created on 2026-09-29. Never recreate it: it holds invites, memberships and revocations.
          "database_id": "b30aa061-4d2e-4bec-891f-3ec9a461d5c6",
          "migrations_dir": "migrations"
        }
      ],
      "secrets": {
        "required": ["TICKET_SIGNING_KEY", "INVITE_PEPPER"]
      },
      "triggers": {
        "crons": ["*/15 * * * *"]
      },
      "ratelimits": [
        {
          "name": "FLOOD",
          // Must remain unique within the Cloudflare account (README, "Changing production").
          "namespace_id": "1001",
          "simple": {
            // Deliberately well above the exact per-identity D1 budgets; this catches floods only.
            "limit": 2000,
            "period": 60
          }
        }
      ],
      "vars": {
        "CONNECT_REQUIRE_FLOOD_LIMIT": "true"
        // Add "CONNECT_DOWNLOAD_URL": "https://…" once the 1Salem Connect download page exists;
        // until then the invite page shows the steps without a download link.
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": false,
          "persist": true
        }
      }
    }
  }
}
