<Window x:Class="ServerManager.Setup.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="1Salem Server Manager Setup"
        Icon="/Assets/1SalemServerManager.ico"
        Width="760"
        Height="760"
        MinWidth="680"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/1SalemServerManager-Icon.png"
                       Width="56"
                       Height="56"
                       Stretch="Uniform"
                       VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="1Salem Server Manager"
                               FontSize="28"
                               FontWeight="Bold" />
                    <TextBlock Text="Version 1.3.1 • Windows 10/11 x64 setup"
                               Margin="0,5,0,0"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Grid>

            <StackPanel x:Name="OptionsPanel" Margin="0,24,0,0">
                <TextBlock Text="Install mode" />
                <ComboBox x:Name="ModeBox"
                          Margin="0,7,0,16"
                          Padding="8"
                          SelectionChanged="ModeBox_SelectionChanged">
                    <ComboBoxItem Content="Client + Agent (All-in-One)"
                                  Tag="AllInOne"
                                  IsSelected="True" />
                    <ComboBoxItem Content="Client only" Tag="ClientOnly" />
                    <ComboBoxItem Content="Agent only" Tag="AgentOnly" />
                </ComboBox>

                <TextBlock Text="Application folder" />
                <Grid Margin="0,7,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallPathBox" Padding="8" />
                    <Button Grid.Column="1"
                            Content="Browse"
                            Click="Browse_Click"
                            Margin="8,0,0,0" />
                </Grid>

                <CheckBox x:Name="DesktopShortcutBox"
                          Content="Create Desktop shortcut"
                          IsChecked="True"
                          Margin="0,4" />
                <CheckBox x:Name="StartMenuShortcutBox"
                          Content="Create Start Menu shortcuts, including Administrator mode"
                          IsChecked="True"
                          Margin="0,4" />
                <CheckBox x:Name="StartAgentBox"
                          Content="Install and start Agent as a Windows service"
                          IsChecked="True"
                          Margin="0,4" />
                <CheckBox x:Name="FirewallBox"
                          Content="Allow Agent, Minecraft, and Palworld on Private networks"
                          IsChecked="False"
                          Margin="0,4" />
                <CheckBox x:Name="StartupBox"
                          Content="Start the dashboard minimized with Windows"
                          IsChecked="False"
                          Margin="0,4" />
                <CheckBox x:Name="LaunchBox"
                          Content="Launch dashboard after setup"
                          IsChecked="True"
                          Margin="0,4" />
            </StackPanel>

            <Border Background="{StaticResource PanelBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,18,0,0">
                <TextBlock Text="Game servers and backups are stored separately under ProgramData or the server root you choose later. Setup, rollback, and uninstall never remove those folders."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock x:Name="StateText"
                       Text="Ready"
                       Margin="0,18,0,0"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}" />
            <ProgressBar x:Name="Progress"
                         Height="10"
                         Minimum="0"
                         Maximum="100"
                         Margin="0,10,0,0" />
            <TextBlock x:Name="StatusText"
                       Text="Choose your options, then select Install."
                       Margin="0,10,0,0"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="LogPathText"
                       Margin="0,7,0,0"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />

            <Grid Margin="0,20,0,0">
                <StackPanel x:Name="DetailsButtons"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                    <Button x:Name="OpenLogButton"
                            Content="Open Install Log"
                            Click="OpenLog_Click"
                            Margin="0,0,8,0" />
                    <Button x:Name="CopyDetailsButton"
                            Content="Copy Error Details"
                            Click="CopyDetails_Click"
                            Margin="0,0,8,0" />
                    <Button x:Name="CloseButton"
                            Content="Close"
                            Click="Close_Click"
                            Margin="0,0,8,0" />
                </StackPanel>
                <Button x:Name="InstallButton"
                        Content="Install"
                        Click="Install_Click"
                        HorizontalAlignment="Right"
                        MinWidth="130" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
