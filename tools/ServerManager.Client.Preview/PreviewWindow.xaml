<Window x:Class="ServerManager.Client.Preview.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ServerManager.Client.Controls;assembly=1Salem.ServerManager"
        Title="1Salem Server Manager — Palworld Overview Preview"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True">
    <Grid x:Name="PreviewRoot" Background="{DynamicResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="28,12">
            <Grid>
                <StackPanel>
                    <TextBlock Text="1Salem Server Manager" FontSize="26" FontWeight="Bold" />
                    <TextBlock Text="Native server dashboard" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource PanelAltBrush}" CornerRadius="16" Padding="14,6">
                    <TextBlock Text="Preview data · no live actions" Foreground="{DynamicResource SuccessBrush}" />
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigationColumn" Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border x:Name="NavigationPanel" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,1,0" Padding="20,24">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Home}" FontSize="16" Margin="10,8,0,18"/>
                    <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="8" Padding="12,10"><TextBlock Text="{DynamicResource Palworld}" FontSize="17" FontWeight="SemiBold"/></Border>
                    <TextBlock Text="{DynamicResource Backups}" FontSize="16" Margin="10,20,0,0"/>
                    <TextBlock Text="{DynamicResource Updates}" FontSize="16" Margin="10,20,0,0"/>
                    <TextBlock Text="{DynamicResource Resources}" FontSize="16" Margin="10,20,0,0"/>
                    <TextBlock Text="{DynamicResource Network}" FontSize="16" Margin="10,20,0,0"/>
                    <TextBlock Text="{DynamicResource About}" FontSize="16" Margin="10,20,0,0"/>
                </StackPanel>
            </Border>
            <Grid Grid.Column="1" Margin="22,16,22,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource Palworld}" FontSize="30" FontWeight="Bold" />
                    <TextBlock Text="{DynamicResource Palworld.Description}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,10"/>
                </StackPanel>
                <TabControl Grid.Row="1">
                    <TabItem Header="Overview">
                        <controls:PalworldOverviewDashboardControl x:Name="Dashboard" />
                    </TabItem>
                    <TabItem Header="Console" />
                    <TabItem Header="Settings" />
                    <TabItem Header="Players" />
                    <TabItem Header="Files" />
                    <TabItem Header="Save &amp; Backups" />
                    <TabItem Header="Updates" />
                    <TabItem Header="Performance" />
                    <TabItem Header="Network" />
                    <TabItem Header="Diagnostics" />
                </TabControl>
            </Grid>
        </Grid>
    </Grid>
</Window>
