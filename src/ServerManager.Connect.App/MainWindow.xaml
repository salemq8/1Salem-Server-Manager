<Window x:Class="ServerManager.Connect.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ServerManager.Connect.App.ViewModels"
        xmlns:views="clr-namespace:ServerManager.Connect.App.Views"
        xmlns:loc="clr-namespace:ServerManager.Connect.App.Localization"
        Title="{Binding Title}"
        Width="760"
        Height="620"
        MinWidth="520"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        FlowDirection="{Binding FlowDirection}"
        UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="{Binding Title}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
            <views:WelcomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InviteViewModel}">
            <views:InviteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WaitingViewModel}">
            <views:WaitingView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServersViewModel}">
            <views:ServersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
            <views:ConnectionView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <views:DiagnosticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            KeyboardNavigation.TabNavigation="Local">
                    <Button Content="{x:Static loc:Text.NavServers}"
                            Command="{Binding ShowServersCommand}"
                            Style="{StaticResource QuietButtonStyle}"
                            Margin="0,0,8,0"
                            Visibility="{Binding CanUseServers, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.Name="{x:Static loc:Text.NavServers}" />
                    <Button Content="{x:Static loc:Text.NavDiagnostics}"
                            Command="{Binding ShowDiagnosticsCommand}"
                            Style="{StaticResource QuietButtonStyle}"
                            Margin="0,0,8,0"
                            AutomationProperties.Name="{x:Static loc:Text.NavDiagnostics}" />
                    <Button Content="{x:Static loc:Text.NavSettings}"
                            Command="{Binding ShowSettingsCommand}"
                            Style="{StaticResource QuietButtonStyle}"
                            AutomationProperties.AutomationId="NavSettings"
                            AutomationProperties.Name="{x:Static loc:Text.NavSettings}" />
                </StackPanel>
                <!-- The product name is Latin text that starts with a digit; laid out right to left it
                     would reorder, so it keeps its own direction inside an Arabic window. Sized to its
                     text, it still sits at the window's start edge (right in Arabic, left in English). -->
                <TextBlock Text="{Binding Title}"
                           Style="{StaticResource SectionTitleStyle}"
                           FlowDirection="LeftToRight"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <!-- A notice that never blocks the page: an update is available, or how the last one ended. -->
        <Border DockPanel.Dock="Top"
                Margin="24,12,24,0"
                Visibility="{Binding HasNotice, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="UpdateNotice">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource NoticeStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NoticeIsWarning}" Value="False">
                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            KeyboardNavigation.TabNavigation="Local">
                    <Button Content="{Binding NoticeActionText}"
                            Command="{Binding NoticeActionCommand}"
                            Style="{StaticResource PrimaryActionStyle}"
                            MinWidth="0"
                            Margin="0,0,8,0"
                            Visibility="{Binding HasNoticeAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.AutomationId="UpdateNoticeAction"
                            AutomationProperties.Name="{Binding NoticeActionText}" />
                    <Button Content="{x:Static loc:Text.NoticeDismiss}"
                            Command="{Binding DismissNoticeCommand}"
                            Style="{StaticResource QuietButtonStyle}"
                            AutomationProperties.Name="{x:Static loc:Text.NoticeDismiss}" />
                </StackPanel>
                <TextBlock Text="{Binding NoticeText}"
                           Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           AutomationProperties.AutomationId="UpdateNoticeText"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
        <!-- Named explicitly: otherwise UI Automation names the region after its content, which
             is a view model, and a screen reader would read out a .NET type name. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False"
                      AutomationProperties.Name="{Binding Title}">
            <ContentControl Content="{Binding CurrentPage}"
                            Margin="{StaticResource PagePadding}"
                            MaxWidth="680"
                            Focusable="False"
                            IsTabStop="False" />
        </ScrollViewer>
    </DockPanel>
</Window>
