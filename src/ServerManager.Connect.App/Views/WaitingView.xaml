<UserControl x:Class="ServerManager.Connect.App.Views.WaitingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ServerManager.Connect.App.Localization"
             AutomationProperties.Name="{x:Static loc:Text.WaitingTitle}">
    <StackPanel>
        <TextBlock Text="{x:Static loc:Text.WaitingTitle}"
                   Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding Body}"
                   Style="{StaticResource BodyTextStyle}"
                   Margin="0,12,0,0" />
        <Border Style="{StaticResource SectionCardStyle}"
                Margin="0,22,0,0">
            <StackPanel>
                <TextBlock Text="{Binding ServerLabel}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{Binding StatusText}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,6,0,0"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar IsIndeterminate="True"
                             Margin="0,14,0,0"
                             Visibility="{Binding IsWaiting, Converter={StaticResource BooleanToVisibilityConverter}}"
                             AutomationProperties.Name="{x:Static loc:Text.WaitingStatus}" />
            </StackPanel>
        </Border>
        <Button Content="{x:Static loc:Text.CommonBack}"
                Command="{Binding BackCommand}"
                Style="{StaticResource QuietButtonStyle}"
                HorizontalAlignment="Left"
                Margin="0,22,0,0"
                IsCancel="True"
                AutomationProperties.Name="{x:Static loc:Text.CommonBack}" />
    </StackPanel>
</UserControl>
