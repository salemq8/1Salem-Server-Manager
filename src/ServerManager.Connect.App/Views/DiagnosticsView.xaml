<UserControl x:Class="ServerManager.Connect.App.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ServerManager.Connect.App.Localization"
             AutomationProperties.Name="{x:Static loc:Text.DiagnosticsTitle}">
    <StackPanel>
        <TextBlock Text="{x:Static loc:Text.DiagnosticsTitle}"
                   Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{x:Static loc:Text.DiagnosticsBody}"
                   Style="{StaticResource PageSubtitleStyle}" />
        <StackPanel Orientation="Horizontal"
                    Margin="0,18,0,12">
            <Button Content="{x:Static loc:Text.DiagnosticsRefresh}"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource QuietButtonStyle}"
                    Margin="0,0,8,0"
                    AutomationProperties.Name="{x:Static loc:Text.DiagnosticsRefresh}" />
            <Button Content="{x:Static loc:Text.DiagnosticsCopy}"
                    Command="{Binding CopyCommand}"
                    Style="{StaticResource QuietButtonStyle}"
                    AutomationProperties.Name="{x:Static loc:Text.DiagnosticsCopy}" />
        </StackPanel>
        <TextBox Text="{Binding ReportText, Mode=OneWay}"
                 Style="{StaticResource TechnicalTextBoxStyle}"
                 MinHeight="320"
                 AutomationProperties.Name="{x:Static loc:Text.DiagnosticsReportLabel}" />
    </StackPanel>
</UserControl>
