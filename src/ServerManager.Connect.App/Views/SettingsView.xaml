<UserControl x:Class="ServerManager.Connect.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ServerManager.Connect.App.Localization"
             AutomationProperties.Name="{x:Static loc:Text.SettingsTitle}">
    <StackPanel>
        <TextBlock Text="{x:Static loc:Text.SettingsTitle}"
                   Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{x:Static loc:Text.SettingsBody}"
                   Style="{StaticResource PageSubtitleStyle}" />

        <!-- Updates -->
        <Border Style="{StaticResource SectionCardStyle}"
                Margin="0,20,0,0"
                AutomationProperties.Name="{x:Static loc:Text.UpdatesTitle}">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Text.UpdatesTitle}"
                           Style="{StaticResource SectionTitleStyle}" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{x:Static loc:Text.UpdatesVersionLabel}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,24,6" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding VersionText}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"
                               AutomationProperties.Name="{x:Static loc:Text.UpdatesVersionLabel}" />
                    <TextBlock Grid.Row="1" Text="{x:Static loc:Text.UpdatesBuildLabel}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,24,6" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BuildText}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"
                               AutomationProperties.AutomationId="UpdatesCurrentBuild"
                               AutomationProperties.Name="{x:Static loc:Text.UpdatesBuildLabel}" />
                    <TextBlock Grid.Row="2" Text="{x:Static loc:Text.UpdatesStatusLabel}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,24,6" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" Margin="0,0,0,6"
                               AutomationProperties.AutomationId="UpdatesStatus"
                               AutomationProperties.LiveSetting="Polite"
                               AutomationProperties.Name="{x:Static loc:Text.UpdatesStatusLabel}" />
                    <TextBlock Grid.Row="3" Text="{x:Static loc:Text.UpdatesLastCheckedLabel}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,24,6" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastCheckedText}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"
                               AutomationProperties.Name="{x:Static loc:Text.UpdatesLastCheckedLabel}" />
                    <TextBlock Grid.Row="4" Text="{x:Static loc:Text.UpdatesChannelLabel}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,24,0" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ChannelText}" Style="{StaticResource BodyTextStyle}"
                               AutomationProperties.Name="{x:Static loc:Text.UpdatesChannelLabel}" />
                </Grid>

                <!-- The newer release, in words: Version and Build on their own lines. -->
                <Border Style="{StaticResource StatusBadgeStyle}"
                        Margin="0,14,0,0"
                        Padding="14,8"
                        CornerRadius="{StaticResource RadiusSm}"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Text.UpdatesStatusAvailable}" Style="{StaticResource StatusBadgeTextStyle}" />
                        <TextBlock Text="{Binding AvailableVersionText}" Style="{StaticResource BodyTextStyle}" />
                        <TextBlock Text="{Binding AvailableBuildText}" Style="{StaticResource BodyTextStyle}"
                                   AutomationProperties.AutomationId="UpdatesAvailableBuild" />
                    </StackPanel>
                </Border>

                <ProgressBar Height="6"
                             Margin="0,14,0,0"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding DownloadPercent, Mode=OneWay}"
                             Foreground="{DynamicResource AccentBrush}"
                             Background="{DynamicResource SurfaceSunkenBrush}"
                             BorderThickness="0"
                             Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"
                             AutomationProperties.Name="{Binding StatusText}" />

                <Border Style="{StaticResource NoticeStyle}"
                        Margin="0,14,0,0"
                        Visibility="{Binding HasProblem, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ProblemText}"
                               Style="{StaticResource BodyTextStyle}"
                               AutomationProperties.AutomationId="UpdatesProblem"
                               AutomationProperties.LiveSetting="Assertive" />
                </Border>

                <!-- Connected to a server: never updated out from under the friend. -->
                <Border Style="{StaticResource NoticeStyle}"
                        Margin="0,14,0,0"
                        Visibility="{Binding NeedsDisconnect, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:Text.UpdatesDisconnectFirst}"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Text="{x:Static loc:Text.UpdatesDisconnectDetail}"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,4,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{x:Static loc:Text.UpdatesDisconnectAndUpdate}"
                                    Command="{Binding DisconnectAndUpdateCommand}"
                                    Style="{StaticResource PrimaryActionStyle}"
                                    Margin="0,0,8,0"
                                    AutomationProperties.AutomationId="UpdatesDisconnectAndUpdate"
                                    AutomationProperties.Name="{x:Static loc:Text.UpdatesDisconnectAndUpdate}" />
                            <Button Content="{x:Static loc:Text.UpdatesLater}"
                                    Command="{Binding LaterCommand}"
                                    Style="{StaticResource QuietButtonStyle}"
                                    AutomationProperties.Name="{x:Static loc:Text.UpdatesLater}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Portable: told, never overwritten. -->
                <StackPanel Margin="0,14,0,0"
                            Visibility="{Binding ShowPortableDownload, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{x:Static loc:Text.UpdatesPortableAvailable}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Static loc:Text.UpdatesPortableDetail}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,16,0,0"
                            KeyboardNavigation.TabNavigation="Local">
                    <Button Content="{x:Static loc:Text.UpdatesCheck}"
                            Command="{Binding CheckCommand}"
                            Style="{StaticResource QuietButtonStyle}"
                            Margin="0,0,8,0"
                            AutomationProperties.AutomationId="UpdatesCheck"
                            AutomationProperties.Name="{x:Static loc:Text.UpdatesCheck}" />
                    <Button Content="{x:Static loc:Text.UpdatesUpdateNow}"
                            Command="{Binding UpdateNowCommand}"
                            Style="{StaticResource PrimaryActionStyle}"
                            Margin="0,0,8,0"
                            Visibility="{Binding ShowUpdateNow, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.AutomationId="UpdatesUpdateNow"
                            AutomationProperties.Name="{x:Static loc:Text.UpdatesUpdateNow}" />
                    <Button Content="{x:Static loc:Text.UpdatesPortableDownload}"
                            Command="{Binding DownloadPortableCommand}"
                            Style="{StaticResource PrimaryActionStyle}"
                            Visibility="{Binding ShowPortableDownload, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.AutomationId="UpdatesPortableDownload"
                            AutomationProperties.Name="{x:Static loc:Text.UpdatesPortableDownload}" />
                </StackPanel>

                <TextBlock Text="{x:Static loc:Text.UpdatesAdminNote}"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,12,0,0"
                           Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{x:Static loc:Text.UpdatesPortableNote}"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="0,12,0,0"
                           Visibility="{Binding IsPortable, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>

        <!-- Appearance -->
        <Border Style="{StaticResource SectionCardStyle}"
                Margin="0,16,0,0"
                AutomationProperties.Name="{x:Static loc:Text.AppearanceTitle}">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Text.AppearanceTitle}"
                           Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="{x:Static loc:Text.AppearanceTheme}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,10,0,6" />
                <ListBox ItemsSource="{Binding ThemeOptions}"
                         SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                         DisplayMemberPath="Label"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}"
                         HorizontalAlignment="Left"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.AutomationId="AppearanceTheme"
                         AutomationProperties.Name="{x:Static loc:Text.AppearanceTheme}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="14,7" />
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Chip"
                                                Background="{DynamicResource PanelAltBrush}"
                                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                                                <Setter TargetName="Chip" Property="BorderThickness" Value="2" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
