<UserControl x:Class="ServerManager.Connect.App.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ServerManager.Connect.App.Localization"
             AutomationProperties.Name="{Binding Headline}">
    <StackPanel>
        <TextBlock Text="{Binding Headline}"
                   Style="{StaticResource PageTitleStyle}" />
        <TextBlock Text="{Binding Detail}"
                   Style="{StaticResource BodyTextStyle}"
                   Margin="0,12,0,0" />
        <Border Style="{StaticResource NoticeStyle}"
                Margin="0,18,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorText}"
                       Style="{StaticResource BodyTextStyle}"
                       AutomationProperties.LiveSetting="Assertive" />
        </Border>
        <StackPanel Orientation="Horizontal"
                    Margin="0,24,0,0">
            <Button Content="{x:Static loc:Text.WelcomeGetStarted}"
                    Command="{Binding GetStartedCommand}"
                    Style="{StaticResource PrimaryActionStyle}"
                    IsDefault="True"
                    Visibility="{Binding CanGetStarted, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="{x:Static loc:Text.WelcomeGetStarted}" />
            <Button Content="{x:Static loc:Text.CommonRetry}"
                    Command="{Binding RetryCommand}"
                    Style="{StaticResource PrimaryActionStyle}"
                    Visibility="{Binding CanRetry, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="{x:Static loc:Text.CommonRetry}" />
        </StackPanel>
    </StackPanel>
</UserControl>
