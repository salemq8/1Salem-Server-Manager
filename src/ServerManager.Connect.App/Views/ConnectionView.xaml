<UserControl x:Class="ServerManager.Connect.App.Views.ConnectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ServerManager.Connect.App.Localization"
             AutomationProperties.Name="{Binding ServerLabel}">
    <StackPanel>
        <Button Content="{x:Static loc:Text.CommonBack}"
                Command="{Binding BackCommand}"
                Style="{StaticResource QuietButtonStyle}"
                HorizontalAlignment="Left"
                IsCancel="True"
                AutomationProperties.Name="{x:Static loc:Text.CommonBack}" />
        <TextBlock Text="{Binding ServerLabel}"
                   Style="{StaticResource PageTitleStyle}"
                   Margin="0,16,0,0" />
        <Border Style="{StaticResource StatusBadgeStyle}"
                Margin="0,10,0,0">
            <TextBlock Text="{Binding StateText}"
                       Style="{StaticResource StatusBadgeTextStyle}"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
        <Border Style="{StaticResource SectionCardStyle}"
                Margin="0,22,0,0"
                Visibility="{Binding HasAddress, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{x:Static loc:Text.ConnectionAddressLabel}"
                           Style="{StaticResource CaptionTextStyle}" />
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right"
                            Content="{x:Static loc:Text.ConnectionCopy}"
                            Command="{Binding CopyAddressCommand}"
                            Style="{StaticResource QuietButtonStyle}"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0"
                            AutomationProperties.Name="{x:Static loc:Text.ConnectionCopyAddress}" />
                    <TextBlock Text="{Binding LocalAddress}"
                               Style="{StaticResource AddressValueStyle}"
                               AutomationProperties.Name="{x:Static loc:Text.ConnectionAddressLabel}" />
                </DockPanel>
                <TextBlock Text="{x:Static loc:Text.ConnectionAddressHint}"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,10,0,0" />
            </StackPanel>
        </Border>
        <TextBlock Text="{Binding Message}"
                   Style="{StaticResource SecondaryTextStyle}"
                   Margin="0,14,0,0"
                   Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Orientation="Horizontal"
                    Margin="0,22,0,0">
            <Button Content="{x:Static loc:Text.ConnectionConnect}"
                    Command="{Binding ConnectCommand}"
                    Style="{StaticResource PrimaryActionStyle}"
                    IsDefault="True"
                    Visibility="{Binding CanConnect, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="{x:Static loc:Text.ConnectionConnect}" />
            <Button Content="{x:Static loc:Text.ConnectionDisconnect}"
                    Command="{Binding DisconnectCommand}"
                    Style="{StaticResource QuietButtonStyle}"
                    Visibility="{Binding CanDisconnect, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.Name="{x:Static loc:Text.ConnectionDisconnect}" />
        </StackPanel>
    </StackPanel>
</UserControl>
