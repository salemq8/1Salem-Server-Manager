<UserControl x:Class="ServerManager.Client.Controls.ServerContentTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServerManager.Client.Controls">
    <!--
        The Content Hub for one server: Discover, Installed and Updates. Everything listed
        here comes from an external provider; the app hosts nothing and says so on each card.
    -->
    <UserControl.Resources>
        <controls:ContentIconConverter x:Key="ContentIconConverter" />
    </UserControl.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Heading -->
        <StackPanel Grid.Row="0">
            <TextBlock x:Name="Heading" Style="{StaticResource SectionTitleStyle}" />
            <TextBlock x:Name="Subheading"
                       Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <!-- Sub-navigation and filters -->
        <StackPanel x:Name="ControlsPanel" Grid.Row="1" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" KeyboardNavigation.TabNavigation="Local">
                <RadioButton x:Name="TabDiscover"
                             Style="{StaticResource TabBarButtonStyle}"
                             GroupName="ContentTabs"
                             IsChecked="True"
                             Checked="SubTab_Checked" />
                <RadioButton x:Name="TabInstalled"
                             Style="{StaticResource TabBarButtonStyle}"
                             GroupName="ContentTabs"
                             Checked="SubTab_Checked" />
                <RadioButton x:Name="TabUpdates"
                             Style="{StaticResource TabBarButtonStyle}"
                             GroupName="ContentTabs"
                             Checked="SubTab_Checked" />
            </StackPanel>

            <StackPanel x:Name="FilterRow" Margin="0,14,0,0">
                <!-- Two lines, so every filter stays visible at the window's minimum width. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- What kind of content is being browsed; only types this server can use. -->
                    <ComboBox x:Name="KindBox"
                              Grid.Column="0"
                              MinWidth="140"
                              Margin="0,0,10,0"
                              SelectedIndex="0"
                              SelectionChanged="Kind_Changed" />

                    <!-- Server software to search for; only offered for types where it means something. -->
                    <ComboBox x:Name="PlatformBox"
                              Grid.Column="1"
                              MinWidth="170"
                              Margin="0,0,10,0"
                              SelectionChanged="Filter_Changed" />

                    <Grid Grid.Column="2">
                        <TextBox x:Name="SearchBox"
                                 MinWidth="200"
                                 Padding="10,7"
                                 VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown" />
                        <!-- A hint rather than a floating label; it disappears on the first key. -->
                        <TextBlock x:Name="SearchHint"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="12,0,12,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <ComboBox x:Name="SortBox"
                              MinWidth="140"
                              SelectedIndex="0"
                              SelectionChanged="Filter_Changed" />
                    <ComboBox x:Name="ProviderBox"
                              Margin="10,0,0,0"
                              MinWidth="130"
                              SelectedIndex="0"
                              SelectionChanged="Filter_Changed" />
                    <CheckBox x:Name="CompatibleOnlyBox"
                              Margin="14,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="True"
                              Click="Filter_Changed" />
                </StackPanel>

                <!-- Plugins on a server that cannot load them: browse only, and said so. -->
                <TextBlock x:Name="KindNotice"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
                <!-- A search in progress keeps the current results visible; only this bar moves. -->
                <ProgressBar x:Name="SearchProgress"
                             Height="3"
                             Margin="0,8,0,0"
                             IsIndeterminate="True"
                             Visibility="Hidden" />
                <!-- One provider failing is said here, without taking the other provider's results away. -->
                <TextBlock x:Name="SearchNotice"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>

        <!-- Lists and states -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <!-- Discover -->
            <ScrollViewer x:Name="DiscoverScroller"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="DiscoverList"
                              AutomationProperties.Name="{Binding Tag, RelativeSource={RelativeSource Self}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,10" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Width="48"
                                            Height="48"
                                            CornerRadius="{StaticResource RadiusSm}"
                                            Background="{DynamicResource SurfaceSunkenBrush}"
                                            VerticalAlignment="Top">
                                        <Grid>
                                            <TextBlock Text="&#xE8F1;"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="18"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <Image Source="{Binding IconUrl, Converter={StaticResource ContentIconConverter}}"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,14,0">
                                        <TextBlock Text="{Binding Name}"
                                                   Style="{StaticResource CardValueStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}"
                                                   Style="{StaticResource SecondaryTextStyle}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="40"
                                                   Margin="0,3,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <TextBlock Text="{Binding AuthorLine}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding CompatibilityLine}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Margin="12,0,0,0" />
                                            <TextBlock Text="{Binding DownloadsLine}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Margin="12,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <Border Style="{StaticResource StatusBadgeStyle}">
                                                <TextBlock Text="{Binding KindLabel}"
                                                           Style="{StaticResource StatusBadgeTextStyle}" />
                                            </Border>
                                            <TextBlock Text="{Binding SourceLine}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <Button Content="{Binding ActionLabel}"
                                                Style="{StaticResource PrimaryActionStyle}"
                                                MinWidth="104"
                                                IsEnabled="{Binding CanInstall}"
                                                AutomationProperties.Name="{Binding AutomationName}"
                                                Click="Install_Click" />
                                        <Button Content="{Binding DetailsLabel}"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Margin="0,6,0,0"
                                                Click="Details_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Installed and Updates share one template -->
            <ScrollViewer x:Name="InstalledScroller"
                          Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="InstalledList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,10" Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource CardValueStyle}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding VersionLine}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Text="{Binding SourceLine}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Margin="12,0,0,0" />
                                            <!-- A modpack row also says what the server runs. -->
                                            <TextBlock Text="{Binding EnvironmentLine}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       Margin="12,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Border Style="{StaticResource StatusBadgeStyle}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding KindLabel}"
                                                           Style="{StaticResource StatusBadgeTextStyle}" />
                                            </Border>
                                            <Border Style="{StaticResource StatusBadgeStyle}">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Style="{StaticResource StatusBadgeTextStyle}" />
                                            </Border>
                                            <TextBlock Text="{Binding UpdateLine}"
                                                       Style="{StaticResource CaptionTextStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="10,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Button Content="{Binding ViewProjectLabel}"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Visibility="{Binding CanViewProject,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="ViewProject_Click" />
                                        <Button Content="{Binding DistributeLabel}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding CanDistribute,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                                                AutomationProperties.Name="{Binding DistributeAutomationName}"
                                                Click="Distribute_Click" />
                                        <Button Content="{Binding WithdrawLabel}"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding CanWithdraw,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="Withdraw_Click" />
                                        <Button Content="{Binding UpdateLabel}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="8,0,0,0"
                                                IsEnabled="{Binding CanUpdate}"
                                                AutomationProperties.Name="{Binding UpdateAutomationName}"
                                                Click="Update_Click" />
                                        <Button Content="{Binding RollbackLabel}"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding CanRollback,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Click="Rollback_Click" />
                                        <Button Content="{Binding UninstallLabel}"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding ShowUninstall,
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                                                IsEnabled="{Binding CanUninstall}"
                                                AutomationProperties.Name="{Binding UninstallAutomationName}"
                                                Click="Uninstall_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Loading, empty, error and unsupported all share this panel -->
            <Border x:Name="StatePanel"
                    Style="{StaticResource SectionCardStyle}"
                    Padding="40,48"
                    VerticalAlignment="Top"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" MaxWidth="560">
                    <TextBlock x:Name="StateGlyph"
                               Text="&#xE8F1;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="24"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,14"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock x:Name="StateTitle" Style="{StaticResource StateTitleStyle}" />
                    <TextBlock x:Name="StateMessage" Style="{StaticResource StateMessageStyle}" />
                    <Button x:Name="StateActionButton"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Center"
                            Margin="0,16,0,0"
                            Visibility="Collapsed"
                            Click="StateAction_Click" />
                </StackPanel>
            </Border>

            <!-- Progress for the current operation -->
            <Border x:Name="ProgressPanel"
                    Style="{StaticResource SectionCardStyle}"
                    Padding="16"
                    VerticalAlignment="Bottom"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ProgressText"
                               Style="{StaticResource BodyTextStyle}"
                               AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar x:Name="ProgressBarControl"
                                 Height="4"
                                 Margin="0,8,0,0"
                                 IsIndeterminate="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>



