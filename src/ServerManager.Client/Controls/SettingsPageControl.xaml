<UserControl x:Class="ServerManager.Client.Controls.SettingsPageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServerManager.Client.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Width="196"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,24,12,16">
            <ListBox x:Name="CategoryList"
                     Style="{StaticResource NavigationListStyle}"
                     SelectionChanged="Category_SelectionChanged">
                <ListBoxItem Tag="General" IsSelected="True" />
                <ListBoxItem Tag="Appearance" />
                <ListBoxItem Tag="Backups" />
                <ListBoxItem Tag="Network" />
                <ListBoxItem Tag="Updates" />
                <ListBoxItem Tag="Advanced" />
                <ListBoxItem Tag="About" />
            </ListBox>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{StaticResource PagePadding}">
            <StackPanel MaxWidth="740">

                <!-- ===== General ===== -->
                <StackPanel x:Name="GeneralSection" Visibility="Collapsed">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="GeneralTitle" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="GeneralDescription"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                            <Border Style="{StaticResource SettingRowStyle}" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MinimiseToTrayLabel"
                                               Style="{StaticResource BodyTextStyle}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                    <CheckBox x:Name="MinimiseToTrayToggle"
                                              Grid.Column="1"
                                              IsEnabled="False"
                                              IsChecked="True" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="GeneralNote"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Appearance ===== -->
                <StackPanel x:Name="AppearanceSection" Visibility="Collapsed">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="AppearanceTitle"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="AppearanceDescription"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0" />

                            <Border Style="{StaticResource SettingRowStyle}" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="LanguageLabel"
                                               Style="{StaticResource BodyTextStyle}"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="LanguageBox"
                                              Grid.Column="1"
                                              Width="200"
                                              AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}"
                                              SelectionChanged="Preference_Changed" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ThemeLabel"
                                               Style="{StaticResource BodyTextStyle}"
                                               VerticalAlignment="Center" />
                                    <ComboBox x:Name="ThemeBox"
                                              Grid.Column="1"
                                              Width="200"
                                              AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}"
                                              SelectionChanged="Preference_Changed" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="AppearanceStatus"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Backups / Network: policy lives with the agent ===== -->
                <StackPanel x:Name="PolicySection" Visibility="Collapsed">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="PolicyTitle" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="PolicyBody"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="PolicyActionButton"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="PolicyAction_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Updates ===== -->
                <StackPanel x:Name="UpdatesSection" Visibility="Collapsed">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="UpdatesTitle" Style="{StaticResource SectionTitleStyle}" />
                            <Border Style="{StaticResource SettingRowStyle}" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="UpdatesVersionLabel"
                                                   Style="{StaticResource MetricLabelStyle}"
                                                   Margin="0" />
                                        <TextBlock x:Name="UpdatesVersionValue"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button x:Name="CheckUpdatesButton"
                                            Grid.Column="1"
                                            Style="{StaticResource PrimaryActionStyle}"
                                            VerticalAlignment="Center"
                                            Click="CheckUpdates_Click" />
                                </Grid>
                            </Border>
                            <TextBlock x:Name="UpdatesStatus"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap" />
                            <Expander x:Name="UpdatesAdvanced"
                                      Style="{StaticResource AdvancedDisclosureStyle}"
                                      Margin="0,12,0,0">
                                <TextBlock x:Name="UpdatesAdvancedBody"
                                           Style="{StaticResource TechnicalValueStyle}"
                                           FlowDirection="LeftToRight"
                                           Margin="0,12,0,0" />
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- The proven download/stage/install flow, embedded unchanged -->
                    <Border Style="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
                        <controls:ApplicationUpdateControl x:Name="UpdateInstaller" />
                    </Border>
                </StackPanel>

                <!-- ===== Advanced ===== -->
                <StackPanel x:Name="AdvancedSection" Visibility="Collapsed">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="AdvancedTitle" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="AdvancedIntro"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="DiagnosticsButton"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="Diagnostics_Click" />
                                <Button x:Name="OpenDataFolderButton"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Margin="8,0,0,0"
                                        Click="OpenDataFolder_Click" />
                                <Button x:Name="CopyAgentInfoButton"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Margin="8,0,0,0"
                                        Click="CopyAgentInfo_Click" />
                                <Button x:Name="AdminToolsButton"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Margin="8,0,0,0"
                                        Click="AdminTools_Click" />
                            </StackPanel>
                            <Expander x:Name="AgentExpander"
                                      Style="{StaticResource AdvancedDisclosureStyle}"
                                      Margin="0,14,0,0">
                                <TextBlock x:Name="AgentBody"
                                           Style="{StaticResource TechnicalValueStyle}"
                                           FlowDirection="LeftToRight"
                                           Margin="0,12,0,0" />
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== About ===== -->
                <StackPanel x:Name="AboutSection" Visibility="Collapsed">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="AboutProduct"
                                       Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="AboutVersion"
                                       Style="{StaticResource BodyTextStyle}"
                                       Margin="0,10,0,0" />
                            <TextBlock x:Name="AboutBuild"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,4,0,0" />
                            <TextBlock x:Name="AboutCopyright"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,14,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="AboutLogsButton"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Click="OpenLogs_Click" />
                                <Button x:Name="AboutDiagnosticsButton"
                                        Style="{StaticResource QuietButtonStyle}"
                                        Margin="8,0,0,0"
                                        Click="Diagnostics_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
