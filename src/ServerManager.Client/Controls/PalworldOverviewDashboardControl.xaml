<UserControl x:Class="ServerManager.Client.Controls.PalworldOverviewDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServerManager.Client.Controls"
             MinWidth="620">
    <UserControl.Resources>
        <Style x:Key="OverviewPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="5" />
        </Style>
        <Style x:Key="MetricCardStyle" TargetType="Border" BasedOn="{StaticResource OverviewPanelStyle}">
            <Setter Property="MinHeight" Value="126" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="QuickActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Width" Value="176" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="12,5" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource TabDisabledBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DisabledBrush}" />
                    <Setter Property="Opacity" Value="0.82" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Padding" Value="9,4" />
            <Setter Property="Margin" Value="0,0,7,7" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,7,0,3" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
        <Style x:Key="MetricSupportStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="DashboardScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,13,0,24">
            <Grid x:Name="DashboardHeaderGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" MinWidth="285" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Border x:Name="StatusPanel"
                        Style="{StaticResource OverviewPanelStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ServerNameText"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="VersionSummaryText"
                                   Margin="0,3,0,14"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Palworld.Overview.Status}"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,9" />
                        <WrapPanel x:Name="StatusBadgePanel">
                            <Border x:Name="ProcessBadge" Style="{StaticResource StatusBadgeStyle}"><TextBlock x:Name="ProcessBadgeText" /></Border>
                            <Border x:Name="PortBadge" Style="{StaticResource StatusBadgeStyle}"><TextBlock x:Name="PortBadgeText" /></Border>
                            <Border x:Name="GameReadyBadge" Style="{StaticResource StatusBadgeStyle}"><TextBlock x:Name="GameReadyBadgeText" /></Border>
                            <Border x:Name="RestBadge" Style="{StaticResource StatusBadgeStyle}"><TextBlock x:Name="RestBadgeText" /></Border>
                            <Border x:Name="PlayitBadge" Style="{StaticResource StatusBadgeStyle}"><TextBlock x:Name="PlayitBadgeText" /></Border>
                            <Border x:Name="PublicMappingBadge" Style="{StaticResource StatusBadgeStyle}"><TextBlock x:Name="PublicMappingBadgeText" /></Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="QuickActionsPanel"
                        Grid.Column="1"
                        Style="{StaticResource OverviewPanelStyle}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Palworld.Overview.QuickActions}"
                                   Style="{StaticResource SectionTitleStyle}"
                                   Margin="0,0,0,12" />
                        <WrapPanel x:Name="QuickActionsWrap">
                            <Button x:Name="StartServerButton" Style="{StaticResource QuickActionButtonStyle}" Content="{DynamicResource Palworld.Overview.Action.Start}" Click="StartServer_Click" />
                            <Button x:Name="RefreshButton" Style="{StaticResource QuickActionButtonStyle}" Content="{DynamicResource Palworld.Overview.Action.Refresh}" Click="Refresh_Click" />
                            <Button x:Name="SaveWorldButton" Style="{StaticResource QuickActionButtonStyle}" Content="{DynamicResource Palworld.Overview.Action.SaveWorld}" Click="SaveWorld_Click" />
                            <Button x:Name="AnnouncementButton" Style="{StaticResource QuickActionButtonStyle}" Content="{DynamicResource Palworld.Overview.Action.Announcement}" Click="Announcement_Click" />
                            <Button x:Name="GracefulStopButton" Style="{StaticResource QuickActionButtonStyle}" Content="{DynamicResource Palworld.Overview.Action.GracefulStop}" Click="GracefulStop_Click" />
                            <Button x:Name="RestartButton" Style="{StaticResource QuickActionButtonStyle}" Content="{DynamicResource Palworld.Overview.Action.Restart}" Click="Restart_Click" />
                            <Button x:Name="BackupNowButton" Style="{StaticResource QuickActionButtonStyle}" Content="{DynamicResource Palworld.Overview.Action.BackupNow}" Click="BackupNow_Click" />
                            <Button x:Name="CopyInternetButton" Style="{StaticResource QuickActionButtonStyle}" Content="{DynamicResource Palworld.Overview.Action.CopyInternet}" Click="CopyInternet_Click" />
                        </WrapPanel>
                        <Border x:Name="AnnouncementPanel"
                                Visibility="Collapsed"
                                Margin="0,3,0,8"
                                Padding="10"
                                CornerRadius="8"
                                Background="{DynamicResource PanelAltBrush}">
                            <StackPanel>
                                <TextBox x:Name="AnnouncementTextBox"
                                         MaxLength="512"
                                         MinHeight="34"
                                         ToolTip="{DynamicResource Palworld.Overview.AnnouncementHint}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="{DynamicResource Palworld.Overview.Action.Send}" Click="SendAnnouncement_Click" />
                                    <Button Content="{DynamicResource Palworld.Overview.Action.Cancel}" Style="{StaticResource SecondaryButtonStyle}" Click="CancelAnnouncement_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="OperationStatusText"
                                   MinHeight="18"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <UniformGrid x:Name="MetricsGrid" Columns="6">
                <Border Style="{StaticResource MetricCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Palworld.Overview.Metric.Players}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="PlayersValueText" Style="{StaticResource MetricValueStyle}"/><TextBlock x:Name="PlayersSupportText" Style="{StaticResource MetricSupportStyle}"/></StackPanel><TextBlock Grid.Column="1" Text="♟" FontSize="20" Foreground="{DynamicResource AccentBrush}"/></Grid></Border>
                <Border Style="{StaticResource MetricCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Palworld.Overview.Metric.Fps}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="FpsValueText" Style="{StaticResource MetricValueStyle}"/><TextBlock x:Name="FpsSupportText" Style="{StaticResource MetricSupportStyle}"/></StackPanel><TextBlock Grid.Column="1" Text="↗" FontSize="20" Foreground="{DynamicResource AccentBrush}"/></Grid></Border>
                <Border Style="{StaticResource MetricCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Palworld.Overview.Metric.Uptime}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="UptimeValueText" Style="{StaticResource MetricValueStyle}"/><TextBlock x:Name="UptimeSupportText" Style="{StaticResource MetricSupportStyle}"/></StackPanel><TextBlock Grid.Column="1" Text="◷" FontSize="20" Foreground="{DynamicResource AccentBrush}"/></Grid></Border>
                <Border Style="{StaticResource MetricCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Palworld.Overview.Metric.Cpu}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="CpuValueText" Style="{StaticResource MetricValueStyle}"/><TextBlock x:Name="CpuSupportText" Style="{StaticResource MetricSupportStyle}"/></StackPanel><TextBlock Grid.Column="1" Text="⚙" FontSize="20" Foreground="{DynamicResource AccentBrush}"/></Grid></Border>
                <Border Style="{StaticResource MetricCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Palworld.Overview.Metric.Ram}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="RamValueText" Style="{StaticResource MetricValueStyle}"/><TextBlock x:Name="RamSupportText" Style="{StaticResource MetricSupportStyle}"/></StackPanel><TextBlock Grid.Column="1" Text="▣" FontSize="20" Foreground="{DynamicResource AccentBrush}"/></Grid></Border>
                <Border Style="{StaticResource MetricCardStyle}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Palworld.Overview.Metric.LastBackup}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="BackupValueText" Style="{StaticResource MetricValueStyle}" FontSize="18"/><TextBlock x:Name="BackupSupportText" Style="{StaticResource MetricSupportStyle}"/></StackPanel><TextBlock Grid.Column="1" Text="↶" FontSize="20" Foreground="{DynamicResource AccentBrush}"/></Grid></Border>
            </UniformGrid>

            <Grid x:Name="DashboardContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="360" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ActivityPanel" Style="{StaticResource OverviewPanelStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{DynamicResource Palworld.Overview.ServerActivity}" Style="{StaticResource SectionTitleStyle}"/>
                            <ComboBox x:Name="TimeRangeComboBox"
                                      Width="112"
                                      Height="30"
                                      HorizontalAlignment="Right"
                                      ToolTip="{DynamicResource Palworld.Overview.TimeRange}"
                                      SelectionChanged="TimeRange_SelectionChanged">
                                <ComboBoxItem Content="5 min" Tag="00:05:00" IsSelected="True" />
                                <ComboBoxItem Content="15 min" Tag="00:15:00" />
                                <ComboBoxItem Content="1 hour" Tag="01:00:00" />
                            </ComboBox>
                        </Grid>
                        <controls:PalworldActivityGraph x:Name="ActivityGraph" Height="214" />
                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="● Players" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,16,0" />
                            <TextBlock Text="● CPU" Foreground="{DynamicResource AccentBrush}" Margin="0,0,16,0" />
                            <TextBlock Text="● RAM" Foreground="{DynamicResource WarningBrush}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="RecentActivityPanel"
                        Grid.Column="1"
                        Style="{StaticResource OverviewPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource Palworld.Overview.RecentActivity}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,10"/>
                        <TextBlock x:Name="EmptyActivityText"
                                   Grid.Row="1"
                                   Text="{DynamicResource Palworld.Overview.NoActivity}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <ListBox x:Name="RecentActivityList"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="270"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Timestamp}" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                            </Grid>
                                            <TextBlock Text="{Binding Source}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Border Style="{StaticResource OverviewPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Palworld.Overview.ResourceSummary}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
                    <UniformGrid x:Name="ResourceSummaryGrid" Columns="3">
                        <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="8" Padding="14" Margin="0,0,8,0"><StackPanel><TextBlock Text="{DynamicResource Palworld.Overview.Resource.Cpu}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="CpuSummaryValueText" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock x:Name="CpuSummarySupportText" Style="{StaticResource MetricSupportStyle}"/></StackPanel></Border>
                        <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="8" Padding="14" Margin="4,0"><StackPanel><TextBlock Text="{DynamicResource Palworld.Overview.Resource.Ram}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="RamSummaryValueText" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock x:Name="RamSummarySupportText" Style="{StaticResource MetricSupportStyle}"/></StackPanel></Border>
                        <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="8" Padding="14" Margin="8,0,0,0"><StackPanel><TextBlock Text="{DynamicResource Palworld.Overview.Resource.Disk}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="DiskSummaryValueText" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,2"/><TextBlock x:Name="DiskSummarySupportText" Style="{StaticResource MetricSupportStyle}"/></StackPanel></Border>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource OverviewPanelStyle}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Palworld.Overview.Connections}" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
                    <Grid x:Name="ConnectionsGrid">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="250"/><ColumnDefinition Width="*" MinWidth="250"/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource PanelAltBrush}" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Palworld.Overview.LocalNetwork}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="LocalAddressText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,8,0"/></StackPanel><Button x:Name="CopyLocalButton" Grid.Column="1" Content="{DynamicResource Palworld.Overview.Action.Copy}" Style="{StaticResource SecondaryButtonStyle}" Click="CopyLocal_Click"/></Grid>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource PanelAltBrush}" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Palworld.Overview.InternetPlayit}" Style="{StaticResource MetricLabelStyle}"/><TextBlock x:Name="InternetAddressText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,8,0"/><TextBlock x:Name="ProtocolTargetText" Style="{StaticResource MetricSupportStyle}" Margin="0,3,8,0"/></StackPanel><Button x:Name="CopyPublicButton" Grid.Column="1" Content="{DynamicResource Palworld.Overview.Action.Copy}" Style="{StaticResource SecondaryButtonStyle}" Click="CopyInternet_Click"/></Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
