<UserControl x:Class="ServerManager.Client.Controls.PalworldMemoryPerformanceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <UserControl.Resources>
        <Style x:Key="MemoryPresetRadioStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
            <Setter Property="BorderBrush" Value="#3B566D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,9" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PresetBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PresetBorder"
                                        Property="BorderBrush"
                                        Value="#72E2DE" />
                                <Setter TargetName="PresetBorder"
                                        Property="Background"
                                        Value="#1C3448" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PresetBorder"
                                        Property="Background"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="PresetBorder"
                                        Property="BorderBrush"
                                        Value="#9FF5F1" />
                                <Setter TargetName="PresetBorder"
                                        Property="BorderThickness"
                                        Value="2" />
                                <Setter Property="Foreground" Value="#031719" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource MutedTextBrush}" />
                                <Setter TargetName="PresetBorder"
                                        Property="Background"
                                        Value="#243342" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MemoryEditorTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="9" />
            <Setter Property="MinWidth" Value="130" />
            <Style.Triggers>
                <Trigger Property="IsReadOnly" Value="True">
                    <Setter Property="Background" Value="#243342" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource MutedTextBrush}" />
                    <Setter Property="BorderBrush" Value="#405064" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,18,0,8">
                <Grid Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Memory &amp; Performance Policy"
                                   FontSize="24"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Set Palworld warnings, shared budgets, priority, and optional safeguards. Native Palworld memory remains dynamic."
                                   Margin="0,5,120,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Content="Refresh"
                            HorizontalAlignment="Right"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="Refresh_Click" />
                </Grid>

                <WrapPanel>
                    <Border Style="{StaticResource DashboardCardStyle}" Width="215">
                        <StackPanel>
                            <TextBlock Text="System memory"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="SystemMemoryText"
                                       Style="{StaticResource CardValueStyle}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCardStyle}" Width="215">
                        <StackPanel>
                            <TextBlock Text="Palworld process tree"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="PalworldMemoryText"
                                       Style="{StaticResource CardValueStyle}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCardStyle}" Width="215">
                        <StackPanel>
                            <TextBlock Text="Managed servers"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="ServerMemoryText"
                                       Style="{StaticResource CardValueStyle}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashboardCardStyle}" Width="215">
                        <StackPanel>
                            <TextBlock Text="Process identity"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="ProcessIdentityText"
                                       Style="{StaticResource CardValueStyle}"
                                       TextWrapping="Wrap"
                                       TextTrimming="None" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border Style="{StaticResource ServerCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Policy preset"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Select one profile. The selected state is persistent and is never changed by hover or focus."
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,12,0,0">
                            <RadioButton x:Name="SafeButton"
                                         Content="Safe"
                                         GroupName="MemoryPolicyPreset"
                                         Tag="Safe"
                                         Style="{StaticResource MemoryPresetRadioStyle}"
                                         IsChecked="{Binding IsSafeSelected, Mode=OneWay}"
                                         Command="{Binding SelectPresetCommand}"
                                         CommandParameter="Safe" />
                            <RadioButton x:Name="BalancedButton"
                                         Content="Balanced"
                                         GroupName="MemoryPolicyPreset"
                                         Tag="Balanced"
                                         Style="{StaticResource MemoryPresetRadioStyle}"
                                         IsChecked="{Binding IsBalancedSelected, Mode=OneWay}"
                                         Command="{Binding SelectPresetCommand}"
                                         CommandParameter="Balanced" />
                            <RadioButton x:Name="PerformanceButton"
                                         Content="Performance"
                                         GroupName="MemoryPolicyPreset"
                                         Tag="Performance"
                                         Style="{StaticResource MemoryPresetRadioStyle}"
                                         IsChecked="{Binding IsPerformanceSelected, Mode=OneWay}"
                                         Command="{Binding SelectPresetCommand}"
                                         CommandParameter="Performance" />
                            <RadioButton x:Name="CustomButton"
                                         Content="Custom"
                                         GroupName="MemoryPolicyPreset"
                                         Tag="Custom"
                                         Style="{StaticResource MemoryPresetRadioStyle}"
                                         IsChecked="{Binding IsCustomSelected, Mode=OneWay}"
                                         Command="{Binding SelectPresetCommand}"
                                         CommandParameter="Custom" />
                            <RadioButton x:Name="OneGameButton"
                                         Content="One Game at a Time"
                                         GroupName="MemoryPolicyPreset"
                                         Tag="OneGameAtATime"
                                         Style="{StaticResource MemoryPresetRadioStyle}"
                                         IsChecked="{Binding IsOneGameAtATimeSelected, Mode=OneWay}"
                                         Command="{Binding SelectPresetCommand}"
                                         CommandParameter="OneGameAtATime" />
                        </WrapPanel>
                        <TextBlock x:Name="ActiveProfileText"
                                   Text="{Binding ActiveProfileSummary}"
                                   Margin="0,5,0,0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ServerCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Memory thresholds and shared budget"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Custom keeps typed values pending until Save Changes. Refreshing metrics does not replace pending input."
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Text="Windows reserve" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ReserveBox"
                                             Style="{StaticResource MemoryEditorTextBoxStyle}"
                                             IsReadOnly="{Binding MemoryFieldsReadOnly}"
                                             Text="{Binding WindowsReserveGiB, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             ToolTip="RAM kept available for Windows and non-server applications."
                                             automation:AutomationProperties.Name="Windows reserved memory" />
                                    <TextBlock Grid.Column="1"
                                               Text="GiB"
                                               Margin="8,9,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=ReserveBox}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Text="Warning threshold" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="WarningBox"
                                             Style="{StaticResource MemoryEditorTextBoxStyle}"
                                             IsReadOnly="{Binding MemoryFieldsReadOnly}"
                                             Text="{Binding WarningThresholdGiB, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             ToolTip="Show a memory warning when the Palworld process tree reaches this value."
                                             automation:AutomationProperties.Name="Palworld memory warning threshold" />
                                    <TextBlock Grid.Column="1"
                                               Text="GiB"
                                               Margin="8,9,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=WarningBox}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Text="Critical threshold" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CriticalBox"
                                             Style="{StaticResource MemoryEditorTextBoxStyle}"
                                             IsReadOnly="{Binding MemoryFieldsReadOnly}"
                                             Text="{Binding CriticalThresholdGiB, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             ToolTip="Critical Palworld process-tree threshold used by notifications and the optional safe restart."
                                             automation:AutomationProperties.Name="Palworld critical memory threshold" />
                                    <TextBlock Grid.Column="1"
                                               Text="GiB"
                                               Margin="8,9,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CriticalBox}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,0,16,12">
                                <TextBlock Text="Total server budget" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BudgetBox"
                                             Style="{StaticResource MemoryEditorTextBoxStyle}"
                                             IsReadOnly="{Binding MemoryFieldsReadOnly}"
                                             Text="{Binding TotalServerBudgetGiB, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             ToolTip="Maximum combined working-set budget for registered running servers."
                                             automation:AutomationProperties.Name="Maximum total server memory budget" />
                                    <TextBlock Grid.Column="1"
                                               Text="GiB"
                                               Margin="8,9,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Grid>
                                <TextBlock Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=BudgetBox}"
                                           Foreground="{DynamicResource WarningBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding CapacityCalculation}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10" />
                        <WrapPanel>
                            <CheckBox x:Name="CriticalNotificationBox"
                                      Content="Notify at critical threshold"
                                      IsEnabled="{Binding CanEditMemoryThresholds}"
                                      IsChecked="{Binding NotifyAtCriticalThreshold}"
                                      ToolTip="Show a local warning when Palworld reaches the critical threshold."
                                      Margin="0,5,20,5" />
                            <CheckBox x:Name="AutoSaveRestartBox"
                                      Content="Automatically Save World + Graceful Restart"
                                      IsEnabled="{Binding CanEditMemoryThresholds}"
                                      IsChecked="{Binding AutoSaveAndRestart}"
                                      ToolTip="Requires working local Palworld management. Save failure cancels the restart."
                                      Margin="0,5,20,5" />
                            <CheckBox x:Name="OverrideBudgetBox"
                                      Content="Allow unsafe startup override after confirmation"
                                      IsEnabled="{Binding CanEditMemoryThresholds}"
                                      IsChecked="{Binding AllowUnsafeStartupOverride}"
                                      ToolTip="Enables Start Anyway Once for manual starts only. Auto Start and hard limits remain enforced."
                                      Margin="0,5,20,5" />
                        </WrapPanel>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Active values"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}" />
                                <TextBlock Text="{Binding ActiveValuesSummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Pending values"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}" />
                                <TextBlock Text="{Binding PendingValuesSummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ServerCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Server start budget"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="BudgetStatusText"
                                   Margin="0,7,0,10"
                                   TextWrapping="Wrap" />
                        <WrapPanel>
                            <Button Content="Recalculate Now"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="RecalculateBudget_Click" />
                            <Button x:Name="StartAnywayButton"
                                    Content="Start Anyway Once"
                                    Background="{DynamicResource WarningBrush}"
                                    Foreground="#241705"
                                    Visibility="Collapsed"
                                    Click="StartAnywayOnce_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ServerCardStyle}">
                    <StackPanel>
                        <TextBlock Text="CPU and priority profile"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="CPU affinity mask (blank = all processors)" />
                                <TextBox x:Name="AffinityBox"
                                         Padding="8"
                                         automation:AutomationProperties.Name="CPU affinity mask" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,10">
                                <TextBlock Text="Stop lower-priority game when policy requires" />
                                <CheckBox x:Name="StopLowerBox"
                                          Content="One heavy server at a time"
                                          Margin="0,10,0,0" />
                            </StackPanel>
                        </UniformGrid>
                        <WrapPanel>
                            <Button x:Name="BalancedPriorityButton"
                                    Content="Balanced"
                                    Tag="Balanced"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="Priority_Click" />
                            <Button x:Name="MinecraftPriorityButton"
                                    Content="Prioritize Minecraft"
                                    Tag="Minecraft"
                                    Visibility="{Binding HasMinecraftServer, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="Priority_Click" />
                            <Button x:Name="PalworldPriorityButton"
                                    Content="Prioritize Palworld"
                                    Tag="Palworld"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Click="Priority_Click" />
                            <CheckBox x:Name="RestoreBalancedBox"
                                      Content="Restore Balanced on server stop"
                                      Margin="12,9,0,0" />
                        </WrapPanel>
                        <TextBlock x:Name="PriorityStatusText"
                                   Margin="0,7,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Theme token, not a literal: the body text follows the theme, and on a
                     fixed dark brown it was near-black on brown in Light. -->
                <Border Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="18"
                        Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Advanced hard memory limit - risky"
                                   Foreground="{DynamicResource WarningBrush}"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Disabled by default. A native process can crash or fail allocations at this limit. The Agent saves the world before enforcement and never silently kills Palworld."
                                   Margin="0,6,0,12"
                                   TextWrapping="Wrap" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Hard limit (GiB, blank = disabled)" />
                                <TextBox x:Name="HardLimitBox" Padding="8" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,8">
                                <TextBlock Text="Type APPLY HARD LIMIT" />
                                <TextBox x:Name="HardConfirmationBox" Padding="8" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ServerCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="RecommendationText"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="PolicyStatusText"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="#284056"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14"
                Margin="0,4,0,0">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding UnsavedChangesText}"
                               Foreground="{DynamicResource WarningBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Saving policy values does not restart Palworld."
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Apply Recommended"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ApplyRecommendedCommand}" />
                    <Button Content="Cancel"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelCommand}" />
                    <Button Content="Save Changes"
                            Command="{Binding SaveChangesCommand}" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
