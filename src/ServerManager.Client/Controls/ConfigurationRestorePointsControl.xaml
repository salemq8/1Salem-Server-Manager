<UserControl x:Class="ServerManager.Client.Controls.ConfigurationRestorePointsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
    <Border Style="{StaticResource ServerCardStyle}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Configuration Restore Points"
                               FontSize="20"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Small, protected snapshots created automatically before settings changes. The latest 10 are retained per server."
                               Margin="0,5,0,12"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="Refresh_Click"
                        automation:AutomationProperties.Name="Refresh configuration restore points" />
            </Grid>

            <ListView x:Name="RestorePointList"
                      MinHeight="150"
                      MaxHeight="230"
                      SelectionChanged="RestorePointList_SelectionChanged"
                      automation:AutomationProperties.Name="Configuration restore point history">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Date" Width="150" DisplayMemberBinding="{Binding Created}" />
                        <GridViewColumn Header="Reason" Width="180" DisplayMemberBinding="{Binding Reason}" />
                        <GridViewColumn Header="Label" Width="170" DisplayMemberBinding="{Binding Label}" />
                        <GridViewColumn Header="State" Width="110" DisplayMemberBinding="{Binding State}" />
                        <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Size}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Background="{DynamicResource PanelAltBrush}"
                    CornerRadius="7"
                    Padding="12"
                    Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock x:Name="SummaryText"
                               Text="Select a restore point to review its redacted change summary."
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="HashText"
                               Margin="0,7,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="LabelBox"
                         MaxLength="80"
                         Margin="0,0,10,8"
                         automation:AutomationProperties.Name="Restore point label"
                         ToolTip="Optional label, up to 80 characters" />
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                    <Button x:Name="CompareButton"
                            Content="Compare"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            Click="Compare_Click" />
                    <Button x:Name="LabelButton"
                            Content="Save Label"
                            Style="{StaticResource SecondaryButtonStyle}"
                            IsEnabled="False"
                            Click="SaveLabel_Click" />
                    <Button x:Name="DeleteButton"
                            Content="Delete"
                            Style="{StaticResource DangerButtonStyle}"
                            IsEnabled="False"
                            Click="Delete_Click" />
                    <Button x:Name="RestoreButton"
                            Content="Restore and Verify"
                            Style="{StaticResource WarningButtonStyle}"
                            IsEnabled="False"
                            Click="Restore_Click" />
                </WrapPanel>
            </Grid>
            <TextBlock x:Name="StatusText"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource MutedTextBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</UserControl>
