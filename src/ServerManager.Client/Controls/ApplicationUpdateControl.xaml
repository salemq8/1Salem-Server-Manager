<UserControl x:Class="ServerManager.Client.Controls.ApplicationUpdateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30,24,30,30">
            <TextBlock Text="Application Update" FontSize="30" FontWeight="Bold" />
            <TextBlock Text="Normal releases download, verify, install, health-check, and roll back without rerunning Setup.exe."
                       Margin="0,5,0,18"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
            <Border Style="{StaticResource ServerCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Current version" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="CurrentVersionText" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Latest version" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="LatestVersionText" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="StageText" FontSize="22" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar x:Name="DownloadProgress"
                                 Height="12"
                                 Margin="0,16,0,0"
                                 Minimum="0"
                                 Maximum="100" />
                    <TextBlock x:Name="ProgressText"
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ServerCardStyle}">
                <StackPanel>
                    <TextBlock Text="Update preferences" FontSize="20" FontWeight="SemiBold" />
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Text="Release channel" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="ChannelBox" Width="140" Padding="7">
                            <ComboBoxItem Content="Stable" />
                            <ComboBoxItem Content="Beta" />
                        </ComboBox>
                        <CheckBox x:Name="AutomaticChecksBox"
                                  Content="Check automatically"
                                  VerticalAlignment="Center"
                                  Margin="16,0,0,0" />
                        <Button Content="Save" Click="SaveSettings_Click" />
                    </WrapPanel>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Check Now" Click="Check_Click" />
                        <Button Content="Download Update" Click="Download_Click" />
                        <Button Content="Update Now" Click="UpdateNow_Click" />
                        <Button Content="Restart and Update" Click="UpdateNow_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="SignatureText"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="RollbackText"
                               Margin="0,5,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ServerCardStyle}">
                <StackPanel>
                    <TextBlock Text="Release notes" FontSize="20" FontWeight="SemiBold" />
                    <TextBox x:Name="ReleaseNotesText"
                             Height="150"
                             Margin="0,8,0,0"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource PanelAltBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ServerCardStyle}">
                <StackPanel>
                    <TextBlock Text="Update history" FontSize="20" FontWeight="SemiBold" />
                    <ListBox x:Name="HistoryList"
                             Height="130"
                             Margin="0,8,0,0"
                             DisplayMemberPath="Display"
                             Background="{DynamicResource PanelAltBrush}" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText"
                       Margin="0,14,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
