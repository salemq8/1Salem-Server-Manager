<UserControl x:Class="ServerManager.Client.Controls.ApplicationUpdateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Hosted inside Settings > Updates, which already titles the section and scrolls. A
         ScrollViewer of its own would swallow the mouse wheel for the whole page, and a page
         heading here would repeat the card it sits in. -->
    <StackPanel>

        <!-- Where the update stands -->
        <Border Style="{StaticResource SettingRowStyle}" Padding="0,12,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="CurrentVersionLabel" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock x:Name="CurrentVersionText"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="LatestVersionLabel" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock x:Name="LatestVersionText"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="StageLabel" Style="{StaticResource MetricLabelStyle}" />
                        <TextBlock x:Name="StageText"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="DownloadProgress"
                             Height="6"
                             Margin="0,14,0,0"
                             Minimum="0"
                             Maximum="100" />
                <TextBlock x:Name="ProgressText"
                           Style="{StaticResource CaptionTextStyle}"
                           FlowDirection="LeftToRight"
                           HorizontalAlignment="Left"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- The proven download / verify / install flow. The Check button stays for the
             availability logic below, but the card above already offers Check for Updates,
             so a second one on the same page is hidden. -->
        <WrapPanel Margin="0,14,0,0">
            <Button x:Name="CheckButton"
                    Visibility="Collapsed"
                    Click="Check_Click" />
            <Button x:Name="DownloadButton"
                    Style="{StaticResource QuietButtonStyle}"
                    Margin="0,0,8,0"
                    IsEnabled="False"
                    Click="Download_Click" />
            <Button x:Name="UpdateNowButton"
                    Style="{StaticResource PrimaryActionStyle}"
                    IsEnabled="False"
                    Click="UpdateNow_Click" />
        </WrapPanel>
        <TextBlock x:Name="StatusText"
                   Style="{StaticResource SecondaryTextStyle}"
                   Margin="0,10,0,0" />

        <!-- Preferences -->
        <Border Style="{StaticResource SettingRowStyle}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ChannelLabel"
                           Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="ChannelBox"
                          Grid.Column="1"
                          Width="200"
                          AutomationProperties.LabeledBy="{Binding ElementName=ChannelLabel}">
                    <ComboBoxItem x:Name="ChannelStable" />
                    <ComboBoxItem x:Name="ChannelPreview" />
                    <ComboBoxItem x:Name="ChannelDevelopment" />
                </ComboBox>
            </Grid>
        </Border>
        <Border Style="{StaticResource SettingRowStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="AutomaticChecksBox" VerticalAlignment="Center" />
                <Button x:Name="SavePreferencesButton"
                        Grid.Column="1"
                        Style="{StaticResource QuietButtonStyle}"
                        Click="SaveSettings_Click" />
            </Grid>
        </Border>

        <!-- Installed components -->
        <TextBlock x:Name="ComponentsLabel"
                   Style="{StaticResource MetricLabelStyle}"
                   Margin="0,16,0,0" />
        <UniformGrid Columns="4" Margin="0,8,0,0">
            <StackPanel Margin="0,0,12,0">
                <TextBlock x:Name="ClientLabel" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock x:Name="ClientVersionText" Style="{StaticResource BodyTextStyle}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock x:Name="AgentLabel" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock x:Name="AgentVersionText" Style="{StaticResource BodyTextStyle}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock x:Name="UpdaterLabel" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock x:Name="UpdaterVersionText" Style="{StaticResource BodyTextStyle}" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="ChannelStateLabel" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock x:Name="ComponentStateText" Style="{StaticResource BodyTextStyle}" />
            </StackPanel>
        </UniformGrid>
        <TextBlock x:Name="InstalledHistoryText"
                   Style="{StaticResource CaptionTextStyle}"
                   Margin="0,10,0,0" />
        <TextBlock x:Name="SignatureText"
                   Style="{StaticResource CaptionTextStyle}"
                   Margin="0,6,0,0" />
        <TextBlock x:Name="RollbackText"
                   Style="{StaticResource CaptionTextStyle}"
                   Margin="0,4,0,0" />

        <!-- Release notes and history arrive from the update feed as written, so they keep
             left-to-right order regardless of the interface language. -->
        <TextBlock x:Name="ReleaseNotesLabel"
                   Style="{StaticResource MetricLabelStyle}"
                   Margin="0,16,0,0" />
        <TextBox x:Name="ReleaseNotesText"
                 Height="140"
                 Margin="0,8,0,0"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 FlowDirection="LeftToRight"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.LabeledBy="{Binding ElementName=ReleaseNotesLabel}" />
        <TextBlock x:Name="HistoryLabel"
                   Style="{StaticResource MetricLabelStyle}"
                   Margin="0,16,0,0" />
        <ListBox x:Name="HistoryList"
                 Height="120"
                 Margin="0,8,0,0"
                 FlowDirection="LeftToRight"
                 DisplayMemberPath="Display"
                 AutomationProperties.LabeledBy="{Binding ElementName=HistoryLabel}" />
    </StackPanel>
</UserControl>
