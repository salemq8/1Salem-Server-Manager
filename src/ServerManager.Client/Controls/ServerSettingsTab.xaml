<UserControl x:Class="ServerManager.Client.Controls.ServerSettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ServerManager.Client.Controls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Width="188"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0"
                Padding="16,20,12,16">
            <ListBox x:Name="GroupList"
                     Style="{StaticResource NavigationListStyle}"
                     SelectionChanged="Group_SelectionChanged">
                <ListBoxItem Tag="General" IsSelected="True" />
                <ListBoxItem Tag="Game" />
                <ListBoxItem Tag="Network" />
                <ListBoxItem Tag="Resources" />
                <ListBoxItem Tag="Advanced" />
            </ListBox>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="{StaticResource PagePadding}">
            <StackPanel MaxWidth="760">

                <!-- General: name, autostart, updates -->
                <StackPanel x:Name="GeneralGroup">
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="GeneralTitle" Style="{StaticResource SectionTitleStyle}" />
                            <Border Style="{StaticResource SettingRowStyle}" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AutoStartLabel"
                                               Style="{StaticResource BodyTextStyle}"
                                               VerticalAlignment="Center" />
                                    <CheckBox x:Name="AutoStartToggle" Grid.Column="1" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AutoRestartLabel"
                                               Style="{StaticResource BodyTextStyle}"
                                               VerticalAlignment="Center" />
                                    <CheckBox x:Name="AutoRestartToggle" Grid.Column="1" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="SaveGeneralButton"
                                        Style="{StaticResource PrimaryActionStyle}"
                                        Click="SaveGeneral_Click" />
                                <TextBlock x:Name="GeneralStatus"
                                           Style="{StaticResource CaptionTextStyle}"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="UpdatesTitle" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="UpdatesStatus"
                                           Style="{StaticResource SecondaryTextStyle}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                            <Button x:Name="CheckUpdatesButton"
                                    Grid.Column="1"
                                    Style="{StaticResource QuietButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="CheckUpdates_Click" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Game / Network / Resources reuse the same placeholder card until each
                     legacy editor is ported; the group exists so navigation is final. -->
                <Border x:Name="GroupCard"
                        Style="{StaticResource SectionCardStyle}"
                        Visibility="Collapsed"
                        Padding="32,36">
                    <StackPanel>
                        <TextBlock x:Name="GroupTitle" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="GroupBody"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="GroupActions"
                                    Orientation="Horizontal"
                                    Margin="0,18,0,0">
                            <Button x:Name="GroupPrimaryButton"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Visibility="Collapsed"
                                    Click="GroupPrimary_Click" />
                            <Button x:Name="GroupSecondaryButton"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Margin="8,0,0,0"
                                    Visibility="Collapsed"
                                    Click="GroupSecondary_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Network: 1Salem Connect (private friend access). A development preview that is
                     not configured in this build, so the card says so and every action stays
                     disabled; nothing here provisions, invites or revokes anything. -->
                <Border x:Name="ConnectCard"
                        Style="{StaticResource SectionCardStyle}"
                        Visibility="Collapsed"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ConnectTitle"
                                       Style="{StaticResource SectionTitleStyle}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}">
                                <TextBlock x:Name="ConnectBadge" Style="{StaticResource StatusBadgeTextStyle}" />
                            </Border>
                        </Grid>
                        <TextBlock x:Name="ConnectBody"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="ConnectEnableButton"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Margin="0,0,8,8"
                                    IsEnabled="False" />
                            <Button x:Name="ConnectInviteButton"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Margin="0,0,8,8"
                                    IsEnabled="False" />
                            <Button x:Name="ConnectFriendsButton"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Margin="0,0,8,8"
                                    IsEnabled="False" />
                            <Button x:Name="ConnectRevokeButton"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Margin="0,0,8,8"
                                    IsEnabled="False" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- The world-settings editor is laid out for a full-width page: inside this
                     column its header clips and its grid columns squeeze to a few characters.
                     It opens at full size from the group's Configure action instead. -->

                <!-- Resources: the proven memory-policy editor, plus the governor -->
                <Border x:Name="ResourcesEditorCard"
                        Style="{StaticResource SectionCardStyle}"
                        Visibility="Collapsed"
                        Margin="0,12,0,0">
                    <controls:PalworldMemoryPerformanceControl x:Name="MemoryEditor" />
                </Border>

                <!-- Advanced: diagnostics and the technical read-out -->
                <Border x:Name="AdvancedCard"
                        Style="{StaticResource SectionCardStyle}"
                        Visibility="Collapsed"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="AdvancedTitle" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="AdvancedIntro"
                                   Style="{StaticResource SecondaryTextStyle}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                        <Expander x:Name="AdvancedExpander"
                                  Style="{StaticResource AdvancedDisclosureStyle}"
                                  Margin="0,14,0,0">
                            <TextBlock x:Name="AdvancedBody"
                                       Style="{StaticResource TechnicalValueStyle}"
                                       FlowDirection="LeftToRight"
                                       Margin="0,12,0,0" />
                        </Expander>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="CopyDiagnosticsButton"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Click="CopyDiagnostics_Click" />
                            <Button x:Name="OpenFilesButton"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Margin="8,0,0,0"
                                    Click="OpenFiles_Click" />
                            <Button x:Name="FileManagerButton"
                                    Style="{StaticResource QuietButtonStyle}"
                                    Margin="8,0,0,0"
                                    Click="FileManager_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Per-server diagnostics, embedded unchanged -->
                <Border x:Name="DiagnosticsCard"
                        Style="{StaticResource SectionCardStyle}"
                        Visibility="Collapsed"
                        Margin="0,12,0,0">
                    <controls:ServerDiagnosticsControl x:Name="DiagnosticsEditor" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
