<Window x:Class="ServerManager.Client.LegacyServerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ServerManager.Client.Controls"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        Title="1Salem Server Manager">
    <!--
        Hosts the proven Build 5 editors unchanged. Server Detail links here for the editors
        that are too large to inline, so no management capability is orphaned while they are
        ported one at a time. Their backend logic is untouched.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="24,16"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="HeaderTitle" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock x:Name="HeaderSubtitle"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <controls:GameServerPageControl x:Name="LegacyPage" Grid.Row="1" />
    </Grid>
</Window>
