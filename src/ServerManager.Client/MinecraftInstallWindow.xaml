<Window x:Class="ServerManager.Client.MinecraftInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Minecraft Server"
        Width="940"
        Height="790"
        MinWidth="860"
        MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBrush}"
                    BorderBrush="#2A3342"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="22,28">
                    <TextBlock Text="Create Minecraft"
                               FontSize="21"
                               FontWeight="Bold" />
                    <TextBlock Text="Vanilla Java Edition"
                               Margin="0,4,0,24"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock x:Name="Step1Label" Text="1  General" Style="{StaticResource WizardStepStyle}" />
                    <TextBlock x:Name="Step2Label" Text="2  Gameplay" Style="{StaticResource WizardStepStyle}" />
                    <TextBlock x:Name="Step3Label" Text="3  Memory" Style="{StaticResource WizardStepStyle}" />
                    <TextBlock x:Name="Step4Label" Text="4  Network" Style="{StaticResource WizardStepStyle}" />
                    <TextBlock x:Name="Step5Label" Text="5  Review" Style="{StaticResource WizardStepStyle}" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="30,26">
                <ScrollViewer x:Name="Step1Panel" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="General"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Text="Choose the managed server identity, official version, destination, and player capacity."
                                   Margin="0,5,0,20"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Server name" />
                        <TextBox x:Name="ServerNameBox"
                                 Text="1Salem Minecraft"
                                 Padding="9"
                                 Margin="0,5,0,12" />
                        <TextBlock Text="Install path" />
                        <Grid Margin="0,5,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBox"
                                     Text="C:\ProgramData\1SalemServerManager\Minecraft"
                                     Padding="9" />
                            <Button Grid.Column="1"
                                    Content="Browse"
                                    Margin="8,0,0,0"
                                    Click="Browse_Click" />
                        </Grid>
                        <TextBlock Text="Minecraft version" />
                        <ComboBox x:Name="VersionBox"
                                  DisplayMemberPath="Id"
                                  Padding="9"
                                  Margin="0,5,0,12" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Server port" />
                                <TextBox x:Name="PortBox"
                                         Text="25565"
                                         Padding="9"
                                         Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Maximum players" />
                                <TextBox x:Name="MaxPlayersBox"
                                         Text="20"
                                         Padding="9"
                                         Margin="0,5,0,0" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="VersionStatusText"
                                   Margin="0,16,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="Step2Panel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Gameplay"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Text="Set the managed server.properties values."
                                   Margin="0,5,0,20"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,10,12">
                                <TextBlock Text="Game mode" />
                                <ComboBox x:Name="GameModeBox" SelectedIndex="0" Padding="9" Margin="0,5,0,0">
                                    <ComboBoxItem Content="survival" />
                                    <ComboBoxItem Content="creative" />
                                    <ComboBoxItem Content="adventure" />
                                    <ComboBoxItem Content="spectator" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="10,0,0,12">
                                <TextBlock Text="Difficulty" />
                                <ComboBox x:Name="DifficultyBox" SelectedIndex="2" Padding="9" Margin="0,5,0,0">
                                    <ComboBoxItem Content="peaceful" />
                                    <ComboBoxItem Content="easy" />
                                    <ComboBoxItem Content="normal" />
                                    <ComboBoxItem Content="hard" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,12">
                                <TextBlock Text="View distance" />
                                <TextBox x:Name="ViewDistanceBox" Text="10" Padding="9" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,12">
                                <TextBlock Text="Simulation distance" />
                                <TextBox x:Name="SimulationDistanceBox" Text="10" Padding="9" Margin="0,5,0,0" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Message of the day" />
                        <TextBox x:Name="MotdBox"
                                 Text="A 1Salem Minecraft Server"
                                 Padding="9"
                                 Margin="0,5,0,14" />
                        <WrapPanel>
                            <CheckBox x:Name="OnlineModeBox" Content="Online mode" IsChecked="True" Margin="0,6,22,6" />
                            <CheckBox x:Name="WhitelistBox" Content="Whitelist" Margin="0,6,22,6" />
                            <CheckBox x:Name="HardcoreBox" Content="Hardcore" Margin="0,6,22,6" />
                            <CheckBox x:Name="PvpBox" Content="PvP" IsChecked="True" Margin="0,6,22,6" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="Step3Panel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Memory"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Text="Use current system memory, not a fixed hardware assumption."
                                   Margin="0,5,0,20"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource DashboardCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Detected total RAM" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="TotalRamText" Style="{StaticResource CardValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DashboardCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Currently available" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="AvailableRamText" Style="{StaticResource CardValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DashboardCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Windows reserve" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="ReserveRamText" Style="{StaticResource CardValueStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DashboardCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Recommended range" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock x:Name="RecommendedRamText" Style="{StaticResource CardValueStyle}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                        <TextBlock Text="Preset" Margin="0,16,0,5" />
                        <ComboBox x:Name="MemoryPresetBox"
                                  SelectedIndex="1"
                                  Padding="9"
                                  SelectionChanged="MemoryPreset_SelectionChanged">
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Balanced" />
                            <ComboBoxItem Content="Performance" />
                            <ComboBoxItem Content="Custom" />
                        </ComboBox>
                        <UniformGrid Columns="2" Margin="0,14,0,0">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Minimum RAM Xms (MB)" />
                                <TextBox x:Name="XmsBox" Text="2048" Padding="9" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Maximum RAM Xmx (MB)" />
                                <TextBox x:Name="XmxBox" Text="4096" Padding="9" Margin="0,5,0,0" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock x:Name="MemoryWarningText"
                                   Margin="0,16,0,0"
                                   Foreground="#F5B75C"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="Step4Panel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Network"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Text="Review the LAN address and ensure the selected port is available."
                                   Margin="0,5,0,20"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <Border Style="{StaticResource ServerCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Resulting local server address"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock x:Name="ResultAddressText"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Margin="0,5,0,12" />
                                <WrapPanel>
                                    <Button Content="Test Port" Click="TestPort_Click" />
                                    <Button Content="Refresh Network" Click="RefreshNetwork_Click" />
                                </WrapPanel>
                                <TextBlock x:Name="PortStatusText"
                                           Margin="0,12,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <CheckBox x:Name="FirewallBox"
                                  IsChecked="True"
                                  Content="Create a Private-network Windows Firewall rule"
                                  Margin="0,0,0,16" />
                        <Border Padding="16"
                                Background="{DynamicResource PanelBrush}"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="This is a LAN address, not a public internet address. External access requires Port Forwarding or a Tunnel service."
                                           TextWrapping="Wrap" />
                                <TextBlock Text="هذا عنوان الشبكة المحلية. للدخول من خارج المنزل تحتاج Port Forwarding أو خدمة Tunnel، وهذه غير مضافة حالياً."
                                           FlowDirection="RightToLeft"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="Step5Panel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Review"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock Text="Confirm every setting before the Agent downloads and starts the server."
                                   Margin="0,5,0,18"
                                   Foreground="{DynamicResource MutedTextBrush}" />
                        <Border Style="{StaticResource ServerCardStyle}">
                            <TextBlock x:Name="ReviewText"
                                       FontFamily="Consolas"
                                       TextWrapping="Wrap" />
                        </Border>
                        <CheckBox x:Name="InstallJavaBox"
                                  IsChecked="True"
                                  Content="Install a verified managed Java runtime automatically if the required version is missing"
                                  Margin="0,0,0,12" />
                        <CheckBox x:Name="EulaBox"
                                  Margin="0,0,0,10">
                            <TextBlock TextWrapping="Wrap">
                                I have read and explicitly accept the Minecraft EULA for this server.
                            </TextBlock>
                        </CheckBox>
                        <TextBlock x:Name="ReviewWarningText"
                                   Foreground="#F5B75C"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="ProgressPanel"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Creating Minecraft Server"
                                   FontSize="28"
                                   FontWeight="Bold" />
                        <TextBlock x:Name="ProgressStageText"
                                   FontSize="19"
                                   FontWeight="SemiBold"
                                   Margin="0,20,0,6" />
                        <TextBlock x:Name="ProgressMessageText"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <ProgressBar x:Name="CreationProgressBar"
                                     Height="14"
                                     Margin="0,16,0,16"
                                     Minimum="0"
                                     Maximum="100" />
                        <ListBox x:Name="ProgressList"
                                 Height="230"
                                 Background="{DynamicResource PanelBrush}"
                                 FontFamily="Consolas" />
                        <Border x:Name="FailureDetailsPanel"
                                Visibility="Collapsed"
                                Margin="0,16,0,0"
                                Padding="16"
                                Background="#2B1B1B"
                                CornerRadius="8"
                                BorderBrush="#8B3E3E"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Actionable failure details"
                                           FontWeight="SemiBold"
                                           Foreground="#FF9C9C" />
                                <TextBlock x:Name="FailureDetailsText"
                                           Margin="0,7,0,10"
                                           TextWrapping="Wrap"
                                           FontFamily="Consolas" />
                                <Button Content="Copy Diagnostics"
                                        HorizontalAlignment="Left"
                                        Click="CopyFailure_Click" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="SuccessPanel"
                                Visibility="Collapsed"
                                Margin="0,16,0,0"
                                Padding="18"
                                Background="#152A21"
                                BorderBrush="#2E7254"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock Text="Server ready"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="SuccessAddressText"
                                           Margin="0,7,0,12"
                                           FontSize="24"
                                           FontWeight="Bold" />
                                <Button Content="Copy Join Address"
                                        HorizontalAlignment="Left"
                                        Click="CopySuccessAddress_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="#2A3342"
                BorderThickness="0,1,0,0"
                Padding="18">
            <Grid>
                <TextBlock x:Name="FooterStatusText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BackButton" Content="Back" Click="Back_Click" />
                    <Button x:Name="NextButton" Content="Next" Margin="8,0,0,0" Click="Next_Click" />
                    <Button x:Name="CreateServerButton"
                            Content="Create Server"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="CreateServer_Click" />
                    <Button x:Name="CloseButton"
                            Content="Close"
                            Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
