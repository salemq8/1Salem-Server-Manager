<Window x:Class="ServerManager.Client.NetworkStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Status"
        Width="650"
        Height="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <StackPanel Margin="28">
        <TextBlock Text="Local Network"
                   FontSize="24"
                   FontWeight="Bold" />
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Agent PC" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="MachineText" FontSize="18" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Preferred IPv4" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock x:Name="AddressText" FontSize="18" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>
        <TextBlock Text="Server addresses" Margin="0,20,0,8" />
        <ListBox x:Name="AddressList"
                 Height="150"
                 DisplayMemberPath="Display"
                 Background="{DynamicResource PanelBrush}"
                 Foreground="{DynamicResource TextBrush}" />
        <WrapPanel Margin="0,14,0,0">
            <Button Content="Copy Selected Address" Click="Copy_Click" Margin="0,0,8,0" />
            <Button Content="Refresh" Click="Refresh_Click" />
        </WrapPanel>
        <TextBlock x:Name="WarningText"
                   Margin="0,16,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}" />
    </StackPanel>
</Window>
