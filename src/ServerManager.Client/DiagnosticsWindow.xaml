<Window x:Class="ServerManager.Client.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About and Diagnostics"
        Width="600"
        Height="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <StackPanel Margin="28">
        <TextBlock Text="1Salem Server Manager"
                   FontSize="24"
                   FontWeight="Bold" />
        <TextBlock Text="Version 1.0"
                   Margin="0,6,0,18"
                   Foreground="{DynamicResource MutedTextBrush}" />
        <TextBlock Text="Diagnostic reports contain application and operating-system details plus a redacted Agent log tail. They never include the SQLite database, game files, passwords, or tokens."
                   TextWrapping="Wrap" />
        <Button Content="Export Diagnostic Report"
                Click="Export_Click"
                HorizontalAlignment="Left"
                Margin="0,20,0,0"
                AutomationProperties.Name="Export a redacted diagnostic report" />
        <TextBlock x:Name="StatusText"
                   Margin="0,14,0,0"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}" />
    </StackPanel>
</Window>
