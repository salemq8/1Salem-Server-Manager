<Window x:Class="ServerManager.Client.ConnectFriendsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="680" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Style="{StaticResource PageTitleStyle}" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
            <StackPanel x:Name="FriendsPanel" />
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" />
            <Button x:Name="CloseButton" Style="{StaticResource QuietButtonStyle}"
                    HorizontalAlignment="Left" Margin="0,10,0,0" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
