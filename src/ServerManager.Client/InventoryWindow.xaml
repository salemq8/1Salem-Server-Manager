<Window x:Class="ServerManager.Client.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="850" MinWidth="760" MinHeight="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="PlayerText" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
            <TextBlock x:Name="SourceText" Foreground="{DynamicResource AccentBrush}" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="HintText" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,12" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ArmorHeading" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,6" />
                        <StackPanel x:Name="ArmorPanel" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24">
                        <TextBlock x:Name="ReadOnlyHeading" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="ReadOnlyText" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <TextBlock x:Name="OffhandHeading" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,6" />
                        <StackPanel x:Name="OffhandPanel" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="MainHeading" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,6" />
                <UniformGrid x:Name="MainSlots" Rows="3" Columns="9" />
                <TextBlock x:Name="HotbarHeading" Style="{StaticResource SecondaryTextStyle}" Margin="0,14,0,6" />
                <UniformGrid x:Name="HotbarSlots" Rows="1" Columns="9" />
                <TextBlock x:Name="DetailsHeading" Style="{StaticResource SecondaryTextStyle}" Margin="0,14,0,6" />
                <TextBox x:Name="DetailsText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="95" MaxHeight="220"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         FlowDirection="LeftToRight" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button x:Name="RefreshButton" Style="{StaticResource QuietButtonStyle}" Click="Refresh_Click" />
            <Button x:Name="CloseButton" Style="{StaticResource QuietButtonStyle}" Margin="12,0,0,0" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
