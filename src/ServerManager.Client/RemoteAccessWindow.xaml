<Window x:Class="ServerManager.Client.RemoteAccessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ServerManager.Client.Controls"
        Width="1100"
        Height="780"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <!--
        Hosts the proven Build 5 remote-access control unchanged: installing and linking
        Playit, the public address for each game, starting with the Agent, stopping it, and
        turning external access off. The Network page stays the simple answer to "can people
        reach me"; this is where remote access is set up and managed. Backend logic untouched.
    -->
    <controls:RemoteAccessControl x:Name="RemoteAccess" />
</Window>
