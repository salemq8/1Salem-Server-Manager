<Window x:Class="ServerManager.Client.MinecraftGameplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="880"
        Height="780"
        MinWidth="640"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        AutomationProperties.AutomationId="MinecraftGameplayWindow"
        Background="{DynamicResource SurfaceBrush}">
    <!--
        Gamerules, gameplay settings and player administration for one Minecraft server. Every
        value shown is read from the server or its files; the rows are built in code from the
        Agent's snapshot so a rule this server's version does not have is never offered.
    -->
    <Window.Resources>
        <!-- An on/off switch. Space toggles it; the ring shows keyboard focus. -->
        <Style x:Key="SwitchStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Ring"
                                Padding="2"
                                CornerRadius="14"
                                BorderThickness="2"
                                BorderBrush="Transparent"
                                Background="Transparent">
                            <Grid Width="42" Height="22">
                                <Border x:Name="Track"
                                        CornerRadius="11"
                                        BorderThickness="1"
                                        Background="{DynamicResource ControlSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderStrongBrush}" />
                                <Ellipse x:Name="Thumb"
                                         Width="14"
                                         Height="14"
                                         Margin="4,0"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Center" />
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="SubtitleText"
                           Style="{StaticResource SecondaryTextStyle}"
                           Margin="0,4,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RefreshButton"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Style="{StaticResource SecondaryButtonStyle}"
                    AutomationProperties.AutomationId="GameplayRefresh"
                    Click="Refresh_Click" />
        </Grid>

        <Border x:Name="StatusCard"
                Grid.Row="1"
                Margin="0,14,0,0"
                Padding="12,10"
                CornerRadius="{StaticResource RadiusSm}"
                Background="{DynamicResource SurfaceSunkenBrush}">
            <TextBlock x:Name="StatusText"
                       Style="{StaticResource BodyTextStyle}"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="GameplayStatus"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>

        <StackPanel Grid.Row="2"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    KeyboardNavigation.TabNavigation="Local">
            <RadioButton x:Name="TabGameplay"
                         Style="{StaticResource TabBarButtonStyle}"
                         GroupName="GameplayTabs"
                         IsChecked="True"
                         AutomationProperties.AutomationId="GameplayTabGameplay"
                         Checked="Tab_Checked" />
            <RadioButton x:Name="TabPlayers"
                         Style="{StaticResource TabBarButtonStyle}"
                         GroupName="GameplayTabs"
                         AutomationProperties.AutomationId="GameplayTabPlayers"
                         Checked="Tab_Checked" />
        </StackPanel>

        <ScrollViewer x:Name="Scroller"
                      Grid.Row="3"
                      Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <Grid>
                <StackPanel x:Name="GameplayPanel" AutomationProperties.AutomationId="GameplayPanel" />

                <StackPanel x:Name="PlayersPanel"
                            Visibility="Collapsed"
                            AutomationProperties.AutomationId="PlayersPanel">
                    <Border Style="{StaticResource SectionCardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="OnlineHeading" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock x:Name="OnlineSummary"
                                       Style="{StaticResource SecondaryTextStyle}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="PlayersOnlineSummary" />
                            <ListBox x:Name="OnlineList"
                                     Margin="0,10,0,0"
                                     MaxHeight="160"
                                     AutomationProperties.AutomationId="PlayersOnlineList"
                                     SelectionChanged="PlayerList_SelectionChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="ManageHeading" Style="{StaticResource SectionTitleStyle}" />
                            <Label x:Name="NameLabel"
                                   Padding="0"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextBrush}"
                                   Target="{Binding ElementName=NameBox}" />
                            <TextBox x:Name="NameBox"
                                     Margin="0,6,0,0"
                                     MaxLength="16"
                                     Width="260"
                                     HorizontalAlignment="Left"
                                     AutomationProperties.AutomationId="PlayerNameBox"
                                     TextChanged="NameBox_TextChanged" />
                            <TextBlock x:Name="NameHelp"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                            <WrapPanel x:Name="ActionButtons" Margin="0,12,0,0" />
                            <TextBlock x:Name="PlayersHint"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="0,8,0,0"
                                       TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="PlayersHint" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCardStyle}" Padding="16" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="OperatorsHeading" Style="{StaticResource SectionTitleStyle}" />
                                <ListBox x:Name="OperatorsList"
                                         Margin="0,8,0,0"
                                         Height="150"
                                         AutomationProperties.AutomationId="PlayersOperatorsList"
                                         SelectionChanged="PlayerList_SelectionChanged" />
                                <TextBlock x:Name="OperatorsEmpty"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="WhitelistHeading" Style="{StaticResource SectionTitleStyle}" />
                                <ListBox x:Name="WhitelistList"
                                         Margin="0,8,0,0"
                                         Height="150"
                                         AutomationProperties.AutomationId="PlayersWhitelistList"
                                         SelectionChanged="PlayerList_SelectionChanged" />
                                <TextBlock x:Name="WhitelistEmpty"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock x:Name="BannedHeading" Style="{StaticResource SectionTitleStyle}" />
                                <ListBox x:Name="BannedList"
                                         Margin="0,8,0,0"
                                         Height="150"
                                         AutomationProperties.AutomationId="PlayersBannedList"
                                         SelectionChanged="PlayerList_SelectionChanged" />
                                <TextBlock x:Name="BannedEmpty"
                                           Style="{StaticResource CaptionTextStyle}"
                                           Margin="0,8,0,0"
                                           Visibility="Collapsed" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="OpLevelNote"
                               Style="{StaticResource CaptionTextStyle}"
                               Margin="2,10,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SaveStatus"
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,14,0"
                       AutomationProperties.AutomationId="GameplaySaveStatus"
                       AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="SaveButton"
                    Grid.Column="1"
                    Style="{StaticResource PrimaryActionStyle}"
                    MinWidth="160"
                    IsEnabled="False"
                    AutomationProperties.AutomationId="GameplaySave"
                    Click="Save_Click" />
            <Button x:Name="CloseButton"
                    Grid.Column="2"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    AutomationProperties.AutomationId="GameplayClose"
                    Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
