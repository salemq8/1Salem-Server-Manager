<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>1Salem.ServerManager</AssemblyName>
    <ApplicationIcon>..\..\assets\branding\1SalemServerManager.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\branding\1SalemServerManager.ico">
      <Link>Assets\1SalemServerManager.ico</Link>
    </Resource>
    <Resource Include="..\..\assets\branding\1SalemServerManager-Icon.png">
      <Link>Assets\1SalemServerManager-Icon.png</Link>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ServerManager.Contracts\ServerManager.Contracts.csproj" />
    <ProjectReference Include="..\ServerManager.Infrastructure\ServerManager.Infrastructure.csproj" />
  </ItemGroup>
</Project>
