<Window x:Class="ServerManager.Client.ContentProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720"
        Height="640"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource SurfaceBrush}">
    <!--
        Project details for one plugin. The description is plain text only: provider prose is
        never rendered as markup, and no web content runs here.
    -->
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="56"
                    Height="56"
                    CornerRadius="{StaticResource RadiusSm}"
                    Background="{DynamicResource SurfaceSunkenBrush}">
                <Grid>
                    <TextBlock Text="&#xE8F1;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <Image x:Name="IconImage" Stretch="UniformToFill" />
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="NameText" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="ByLine" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Margin="0,18,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource SectionCardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="FactsHeading" Style="{StaticResource SectionTitleStyle}" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="VersionLabel" Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,16,6" />
                            <TextBlock x:Name="VersionValue" Grid.Row="0" Grid.Column="1"
                                       Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="PlatformLabel" Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,16,6" />
                            <TextBlock x:Name="PlatformValue" Grid.Row="1" Grid.Column="1"
                                       Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="GameVersionLabel" Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,16,6" />
                            <TextBlock x:Name="GameVersionValue" Grid.Row="2" Grid.Column="1"
                                       Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="LicenseLabel" Grid.Row="3" Grid.Column="0"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,16,6" />
                            <TextBlock x:Name="LicenseValue" Grid.Row="3" Grid.Column="1"
                                       Style="{StaticResource BodyTextStyle}" Margin="0,0,0,6"
                                       TextWrapping="Wrap" />

                            <TextBlock x:Name="DependencyLabel" Grid.Row="4" Grid.Column="0"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,16,0" />
                            <TextBlock x:Name="DependencyValue" Grid.Row="4" Grid.Column="1"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="AboutHeading" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="DescriptionText"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border x:Name="SoftwareNotice" Style="{StaticResource SectionCardStyle}" Padding="16" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="SoftwareHeading" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap" />
                        <TextBlock x:Name="SoftwareBody" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <ItemsControl x:Name="SoftwareChoices" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <Button Content="{Binding Label}" IsEnabled="{Binding Choice.Software.Available}" Tag="{Binding Choice.Software.Platform}"
                                                Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Click="ChangeSoftware_Click" />
                                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <TextBlock x:Name="SourceText"
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0" />
            <Button x:Name="ViewOnProviderButton"
                    Style="{StaticResource QuietButtonStyle}"
                    Click="ViewOnProvider_Click" />
            <Button x:Name="InstallButton"
                    Style="{StaticResource PrimaryActionStyle}"
                    Margin="8,0,0,0"
                    MinWidth="120"
                    Click="Install_Click" />
            <Button x:Name="CloseButton"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="8,0,0,0"
                    IsCancel="True"
                    IsDefault="True"
                    Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
