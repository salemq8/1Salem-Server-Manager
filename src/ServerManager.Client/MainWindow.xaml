<Window x:Class="ServerManager.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ServerManager.Client.Controls"
        Title="1Salem Server Manager"
        Height="780"
        Width="1280"
        MinHeight="620"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FlowDirection="{Binding FlowDirection}">
    <Window.Resources>
        <!-- Sidebar width is animated rather than bound so collapsing stays smooth. -->
        <Storyboard x:Key="CollapseSidebarStoryboard">
            <DoubleAnimation Storyboard.TargetName="NavigationColumn"
                             Storyboard.TargetProperty="Width"
                             To="64"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="ExpandSidebarStoryboard">
            <DoubleAnimation Storyboard.TargetName="NavigationColumn"
                             Storyboard.TargetProperty="Width"
                             To="228"
                             Duration="0:0:0.18">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- One template drives both the expanded and collapsed sidebar item. The tooltip and
             accessible name are always present: collapsed, the glyph is the only thing left,
             and an unlabelled icon is unusable with a screen reader and guesswork with a
             mouse. -->
        <DataTemplate x:Key="NavigationItemTemplate">
            <Grid ToolTip="{Binding Title}"
                  AutomationProperties.Name="{Binding Title}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="15"
                           Width="22"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding Title}"
                           Margin="10,0,0,0"
                           FontSize="{StaticResource FontSizeBody}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Visibility="{Binding DataContext.SidebarLabelsVisible,
                                                RelativeSource={RelativeSource AncestorType=Window},
                                                Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumnDefinition" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ SIDEBAR ============================ -->
        <Border x:Name="NavigationColumn"
                Width="228"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="12,16,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand + collapse toggle -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- The collapsed rail is 64px wide: the badge and the toggle cannot both
                         fit, so the badge steps aside and the toggle takes the centre. -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0"
                                Visibility="{Binding SidebarLabelsVisible,
                                                     Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Width="26"
                                Height="26"
                                CornerRadius="{StaticResource RadiusSm}"
                                Background="{DynamicResource AccentBrush}">
                            <TextBlock Text="1S"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#031719"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="AppTitle"
                                   Text="1Salem"
                                   Margin="10,0,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Visibility="{Binding SidebarLabelsVisible,
                                                        Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <Button x:Name="NavigationToggleButton"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Click="ToggleNavigation_Click"
                            Content="&#xE700;"
                            FontFamily="Segoe MDL2 Assets"
                            ToolTip="{Binding SidebarToggleTooltip}"
                            AutomationProperties.Name="{Binding SidebarToggleTooltip}">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource IconButtonStyle}">
                                <Setter Property="HorizontalAlignment" Value="Right" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SidebarCollapsed}" Value="True">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <!-- Primary destinations -->
                <ListBox x:Name="NavigationList"
                         Grid.Row="1"
                         Style="{StaticResource NavigationListStyle}"
                         ItemsSource="{Binding PrimarySections}"
                         ItemTemplate="{StaticResource NavigationItemTemplate}"
                         SelectionChanged="NavigationList_SelectionChanged" />

                <!-- Settings pinned to the bottom -->
                <ListBox x:Name="SettingsNavigationList"
                         Grid.Row="2"
                         Style="{StaticResource NavigationListStyle}"
                         ItemTemplate="{StaticResource NavigationItemTemplate}"
                         SelectionChanged="SettingsNavigation_SelectionChanged">
                    <ListBox.ItemsSource>
                        <Binding Path="SettingsSection">
                            <Binding.Converter>
                                <controls:SingleItemConverter />
                            </Binding.Converter>
                        </Binding>
                    </ListBox.ItemsSource>
                </ListBox>
            </Grid>
        </Border>

        <!-- ============================ MAIN ============================ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top bar: title, context, connectivity. Deliberately quiet. -->
            <Border Padding="32,18,32,14"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}"
                                   Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="{Binding PageSubtitle}"
                                   Style="{StaticResource PageSubtitleStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource StatusBadgeStyle}"
                                Background="{DynamicResource SurfaceRaisedBrush}"
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse"
                                               BasedOn="{StaticResource StatusDotStyle}">
                                            <Setter Property="Fill"
                                                    Value="{DynamicResource DangerBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAgentConnected}"
                                                             Value="True">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource SuccessBrush}" />
                                                </DataTrigger>
                                                <!-- Neutral while connecting: nothing has failed yet -->
                                                <DataTrigger Binding="{Binding IsConnecting}"
                                                             Value="True">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource TextTertiaryBrush}" />
                                                </DataTrigger>
                                                <!-- Caution when only administrator rights are missing -->
                                                <DataTrigger Binding="{Binding NeedsElevation}"
                                                             Value="True">
                                                    <Setter Property="Fill"
                                                            Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock x:Name="ConnectionLabel"
                                           Text="{Binding ConnectionLabel}"
                                           Style="{StaticResource StatusBadgeTextStyle}" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Command="{Binding RefreshCommand}"
                                Content="&#xE72C;"
                                FontFamily="Segoe MDL2 Assets"
                                ToolTip="{Binding RefreshTooltip}"
                                AutomationProperties.Name="{Binding RefreshTooltip}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page content. An opaque background here means a page that does not paint its
                 own never reveals the one stacked behind it. -->
            <Grid Grid.Row="1" Background="{DynamicResource SurfaceBrush}">
                <!-- Page visibility is bound through the Window's DataContext on purpose: a
                     page is free to set its own DataContext for its internal bindings, and an
                     unqualified binding here would silently resolve against that instead and
                     leave the page permanently visible. -->
                <controls:HomePageControl
                    x:Name="HomePage"
                    Visibility="{Binding DataContext.IsHomeSelected,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BooleanToVisibilityConverter}}" />

                <controls:ServersPageControl
                    x:Name="ServersPage"
                    Visibility="{Binding DataContext.IsServerListVisible,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Server Detail lives inside Servers, so the sidebar stays on Servers. -->
                <controls:ServerDetailPageControl
                    x:Name="ServerDetailPage"
                    Visibility="{Binding DataContext.IsServerDetailVisible,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BooleanToVisibilityConverter}}" />

                <controls:BackupsPageControl
                    x:Name="BackupsPage"
                    Visibility="{Binding DataContext.IsBackupsSelected,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BooleanToVisibilityConverter}}" />

                <controls:NetworkPageControl
                    x:Name="NetworkPage"
                    Visibility="{Binding DataContext.IsNetworkSelected,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BooleanToVisibilityConverter}}" />

                <controls:SettingsPageControl
                    x:Name="SettingsPage"
                    Visibility="{Binding DataContext.IsSettingsSelected,
                                         RelativeSource={RelativeSource AncestorType=Window},
                                         Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>

        <!-- Notification toast overlays everything -->
        <Border x:Name="NotificationToast"
                Grid.ColumnSpan="2"
                Panel.ZIndex="1000"
                Visibility="Collapsed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,32,28"
                MaxWidth="420"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusMd}"
                Padding="16,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="NotificationTitle"
                               Style="{StaticResource SectionTitleStyle}"
                               FontSize="{StaticResource FontSizeBody}" />
                    <!-- A live region, so a screen reader announces whether an action worked -->
                    <TextBlock x:Name="NotificationMessage"
                               Style="{StaticResource SecondaryTextStyle}"
                               AutomationProperties.LiveSetting="Polite"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        VerticalAlignment="Top"
                        Margin="12,0,0,0"
                        Click="DismissNotification_Click"
                        Content="&#xE711;"
                        FontFamily="Segoe MDL2 Assets"
                        ToolTip="{DynamicResource Shell.Dismiss}"
                        AutomationProperties.Name="{DynamicResource Shell.Dismiss}" />
            </Grid>
        </Border>
    </Grid>
</Window>
