<Window x:Class="ServerManager.Client.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Language and Theme"
        Width="520"
        Height="390"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <StackPanel Margin="28">
        <TextBlock Text="Language and Theme"
                   FontSize="24"
                   FontWeight="Bold" />
        <TextBlock Text="Language"
                   Margin="0,20,0,6" />
        <ComboBox x:Name="LanguageBox" Padding="8">
            <ComboBoxItem Content="English" Tag="en-US" />
            <ComboBoxItem Content="العربية" Tag="ar-SA" />
        </ComboBox>
        <TextBlock Text="Theme"
                   Margin="0,16,0,6" />
        <ComboBox x:Name="ThemeBox" Padding="8">
            <ComboBoxItem Content="Dark" Tag="Dark" />
            <ComboBoxItem Content="Light" Tag="Light" />
        </ComboBox>
        <Button Content="Apply"
                Click="Apply_Click"
                HorizontalAlignment="Left"
                Margin="0,20,0,0" />
        <TextBlock x:Name="StatusText"
                   Margin="0,14,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap" />
    </StackPanel>
</Window>
