<Window x:Class="ServerManager.Client.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Appearance.Title}"
        Width="520"
        Height="390"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}">
    <StackPanel Margin="28">
        <TextBlock Text="{DynamicResource Appearance.Title}"
                   FontSize="24"
                   FontWeight="Bold" />
        <TextBlock Text="{DynamicResource Appearance.Description}"
                   Margin="0,6,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap" />
        <TextBlock Text="{DynamicResource Appearance.Language}"
                   Margin="0,20,0,6" />
        <ComboBox x:Name="LanguageBox" Padding="8">
            <ComboBoxItem Content="{DynamicResource Appearance.English}" Tag="en-US" />
            <ComboBoxItem Content="{DynamicResource Appearance.Arabic}" Tag="ar-SA" />
        </ComboBox>
        <TextBlock Text="{DynamicResource Appearance.Theme}"
                   Margin="0,16,0,6" />
        <ComboBox x:Name="ThemeBox" Padding="8">
            <ComboBoxItem Content="{DynamicResource Appearance.Dark}" Tag="Dark" />
            <ComboBoxItem Content="{DynamicResource Appearance.Light}" Tag="Light" />
            <ComboBoxItem Content="{DynamicResource Appearance.FollowWindows}" Tag="FollowWindows" />
        </ComboBox>
        <Button Content="{DynamicResource Appearance.Apply}"
                Click="Apply_Click"
                HorizontalAlignment="Left"
                Margin="0,20,0,0" />
        <TextBlock x:Name="StatusText"
                   Margin="0,14,0,0"
                   Foreground="{DynamicResource MutedTextBrush}"
                   TextWrapping="Wrap" />
    </StackPanel>
</Window>
