<Window x:Class="ServerManager.Client.ConnectSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="700" Height="690" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="IntroText" Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,10,0,0" TextWrapping="Wrap" />
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StateDot" Style="{StaticResource StatusDotStyle}" />
                        <TextBlock x:Name="StateText" Style="{StaticResource SectionTitleStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="StateDetail" Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SectionCardStyle}" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="PrivacyText" Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ClientIdLabel" Style="{StaticResource MetricLabelStyle}"
                               Margin="0,16,0,6" />
                    <TextBox x:Name="ClientIdBox" FlowDirection="LeftToRight" />
                    <TextBlock x:Name="ClientSecretLabel" Style="{StaticResource MetricLabelStyle}"
                               Margin="0,14,0,6" />
                    <PasswordBox x:Name="ClientSecretBox" FlowDirection="LeftToRight" />
                    <TextBlock x:Name="ActionStatus" Style="{StaticResource SecondaryTextStyle}"
                               Margin="0,10,0,0" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="SaveButton" Style="{StaticResource PrimaryActionStyle}"
                                Margin="0,0,8,8" Click="Save_Click" />
                        <Button x:Name="CheckButton" Style="{StaticResource QuietButtonStyle}"
                                Margin="0,0,8,8" Click="Check_Click" />
                        <Button x:Name="TurnOffButton" Style="{StaticResource QuietButtonStyle}"
                                Margin="0,0,8,8" Click="TurnOff_Click" />
                        <Button x:Name="CloseButton" Style="{StaticResource QuietButtonStyle}"
                                Margin="0,0,8,8" Click="Close_Click" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
