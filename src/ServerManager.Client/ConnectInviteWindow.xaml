<Window x:Class="ServerManager.Client.ConnectInviteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="680" Height="620" MinWidth="580" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28">
        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Name="IntroText" Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
            <Border x:Name="CreateCard" Style="{StaticResource SectionCardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock x:Name="ValidityLabel" Style="{StaticResource MetricLabelStyle}" />
                    <ComboBox x:Name="ValidityBox" Margin="0,8,0,0" SelectedIndex="0" AutomationProperties.LabeledBy="{Binding ElementName=ValidityLabel}">
                        <ComboBoxItem Tag="86400" />
                        <ComboBoxItem Tag="259200" />
                        <ComboBoxItem Tag="604800" />
                    </ComboBox>
                    <Button x:Name="CreateButton" Style="{StaticResource PrimaryActionStyle}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" Click="Create_Click" />
                </StackPanel>
            </Border>
            <Border x:Name="ResultCard" Style="{StaticResource SectionCardStyle}"
                    Margin="0,18,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="ShownOnceText" Style="{StaticResource SecondaryTextStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="LinkLabel" Style="{StaticResource MetricLabelStyle}" Margin="0,16,0,6" />
                    <TextBox x:Name="LinkBox" IsReadOnly="True" FlowDirection="LeftToRight" AutomationProperties.LabeledBy="{Binding ElementName=LinkLabel}" />
                    <Button x:Name="CopyLinkButton" Style="{StaticResource QuietButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="CopyLink_Click" />
                    <TextBlock x:Name="CodeLabel" Style="{StaticResource MetricLabelStyle}" Margin="0,16,0,6" />
                    <TextBox x:Name="CodeBox" IsReadOnly="True" FlowDirection="LeftToRight" AutomationProperties.LabeledBy="{Binding ElementName=CodeLabel}" />
                    <Button x:Name="CopyCodeButton" Style="{StaticResource QuietButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="CopyCode_Click" />
                    <TextBlock x:Name="ExpiryText" Style="{StaticResource SecondaryTextStyle}" Margin="0,14,0,0" />
                    <Button x:Name="RevokeButton" Style="{StaticResource QuietButtonStyle}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" Click="Revoke_Click" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,12,0,0" TextWrapping="Wrap" />
            <Button x:Name="CloseButton" Style="{StaticResource QuietButtonStyle}"
                    HorizontalAlignment="Left" Margin="0,16,0,0" Click="Close_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
